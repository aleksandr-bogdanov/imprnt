# Local-only — real financial data and the rendered deploy bundle. Never committed.
# In an installed plugin these live under plugins/kopeika/; here they only appear if
# you run the CLI from this dir during development.
data/
deploy/
# The consolidated PII zone (tax profiles, pins, forward book). Only the
# committed profiles.example/ templates ship — never a real person's folder.
profiles/
# Staged vault notes are real personal data too — only the placeholder is tracked.
proposed/*
!proposed/.gitkeep
