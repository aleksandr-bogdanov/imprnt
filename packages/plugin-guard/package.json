{
  "name": "imprnt-plugin-guard",
  "version": "0.1.0",
  "description": "imprnt plugin: a deterministic blocklist for dangerous shell commands. Wire guard.js as a PreToolUse hook on Bash.",
  "type": "module",
  "files": [
    "agent.md",
    "README.md",
    "guard.js"
  ],
  "scripts": {
    "build": "bun build src/guard.ts --target=node --outfile=guard.js --banner '#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "keywords": [
    "imprnt",
    "imprnt-plugin",
    "guard",
    "safety"
  ],
  "license": "MIT",
  "author": "Aleksandr Bogdanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksandr-bogdanov/imprnt.git",
    "directory": "packages/plugin-guard"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.2"
  }
}
