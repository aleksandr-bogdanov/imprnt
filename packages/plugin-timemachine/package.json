{
  "name": "imprnt-plugin-timemachine",
  "version": "0.1.0",
  "description": "imprnt plugin: an opt-in local snapshot safety net. Before any mutating tool runs, it snapshots your git working tree (respecting .gitignore) to a side ref, so the agent cannot lose unrecoverable work. Never blocks, local only.",
  "type": "module",
  "files": [
    "agent.md",
    "README.md",
    "timemachine.js",
    ".claude-plugin/plugin.json",
    "hooks/hooks.json"
  ],
  "scripts": {
    "build": "bun build src/timemachine.ts --target=node --outfile=timemachine.js --banner '#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "keywords": [
    "imprnt",
    "imprnt-plugin",
    "timemachine",
    "snapshot",
    "recovery",
    "safety"
  ],
  "license": "MIT",
  "author": "Aleksandr Bogdanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksandr-bogdanov/imprnt.git",
    "directory": "packages/plugin-timemachine"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.2"
  }
}
