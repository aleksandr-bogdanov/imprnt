{
  "name": "imprnt-plugin-statusline",
  "version": "0.1.0",
  "stable": true,
  "description": "imprnt plugin: a customizable status line for imp sessions - model, directory, context usage, session cost. Rides imp's --settings, never touches your Claude config.",
  "type": "module",
  "files": [
    "agent.md",
    "README.md",
    "statusline.js",
    "imp-settings.json"
  ],
  "scripts": {
    "build": "bun build src/statusline.ts --target=node --outfile=statusline.js --banner '#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "keywords": [
    "imprnt",
    "imprnt-plugin",
    "statusline",
    "claude-code"
  ],
  "license": "MIT",
  "author": "Aleksandr Bogdanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksandr-bogdanov/imprnt.git",
    "directory": "packages/plugin-statusline"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.2"
  }
}
