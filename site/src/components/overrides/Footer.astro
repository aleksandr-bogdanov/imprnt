---
// Starlight's footer plus the maker's mark: the landing's colophon row (the
// lines-only mark, "built by bogdanov.wtf", the GitHub link) under a hairline,
// so every docs page signs off the way the landing does.
import Default from "@astrojs/starlight/components/Footer.astro";
import { footer, site } from "../../lib/content";
---

<Default><slot /></Default>

<div class="colophon">
  <p>{footer.copyright}</p>
  <div class="links">
    <a href="https://bogdanov.wtf" target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
        <path d="M1 16.6 H23 M16.2 1 V16.6" stroke="var(--sl-color-text-accent)" stroke-width="2.8"></path>
      </svg>
      built by bogdanov.wtf
    </a>
    <a href={site.repo} target="_blank" rel="noreferrer">GitHub</a>
  </div>
</div>

<style>
  .colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .colophon p {
    margin: 0;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .links a:hover {
    color: var(--sl-color-white);
  }
</style>
