---
/**
 * The three plugin kinds, as cards. Each carries the mechanism (how it reaches
 * the assistant) and real examples. Theme-aware via Starlight's --sl-color tokens.
 */
const KINDS = [
  {
    name: "Data",
    accent: "#36c7bf",
    mech: "Mirrors an outside service locally. A sync command refreshes it. Proposes summary notes, never writes them.",
    egs: ["whenful", "kleinanzeigen"],
    icon: '<path d="M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3z"/><path d="M4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
  },
  {
    name: "Behavior",
    accent: "var(--sl-color-text-accent)",
    mech: "Feeds the assistant a fixed prompt fragment you wire in. The vault never force-feeds it. Remove is deleting the line.",
    egs: ["anti-slop", "character"],
    icon: '<path d="M12 3a4 4 0 0 1 4 4c0 1.5-.8 2.3-1.5 3-.7.7-1 1.2-1 2.5h-3c0-1.8.6-2.7 1.4-3.5.6-.6 1.1-1 1.1-2A2 2 0 0 0 12 6"/><circle cx="12" cy="18" r="1.4"/>',
  },
  {
    name: "Harness",
    accent: "#e0a93f",
    mech: "Changes the session runtime, like a hook or the status line. Plain claude stays plain. The change applies only to sessions you start with imp.",
    egs: ["timemachine", "statusline"],
    icon: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-5 5a1.5 1.5 0 0 0 2.1 2.1l5-5a4 4 0 0 0 5.4-5.4l-2.3 2.3-2.1-2.1z"/>',
  },
];
---

<div class="kinds">
  {
    KINDS.map((k) => (
      <div class="kind" style={`--c: ${k.accent}`}>
        <div class="kind-head">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={k.icon} />
          <span class="kind-name">{k.name}</span>
        </div>
        <p class="kind-mech">{k.mech}</p>
        <div class="kind-egs">
          {k.egs.map((e) => <code>{e}</code>)}
        </div>
      </div>
    ))
  }
</div>

<style>
  .kinds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    margin: 1.5rem 0;
  }
  @media (max-width: 640px) {
    .kinds {
      grid-template-columns: 1fr;
    }
  }

  .kind {
    border: 1px solid var(--sl-color-hairline-shade);
    border-top: 3px solid var(--c);
    border-radius: 12px;
    padding: 1rem 1.1rem 1.1rem;
    background: color-mix(in oklab, var(--c) 4%, var(--sl-color-bg));
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .kind:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 34px -18px color-mix(in oklab, var(--c) 70%, transparent);
  }

  .kind-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--c);
  }
  .kind-head svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .kind-name {
    font-family: var(--sl-font);
    font-weight: 650;
    font-size: 1.05rem;
  }

  .kind-mech {
    margin: 0.6rem 0 0.85rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .kind-egs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .kind-egs code {
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    padding: 0.16rem 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--c) 35%, var(--sl-color-hairline-shade));
    background: color-mix(in oklab, var(--c) 8%, transparent);
    color: var(--c);
  }
</style>
