---
/**
 * session-host page ONLY - the token flow. You log in once by hand, the warm
 * browser keeps each site's session alive, the broker answers one question
 * over localhost, and a consumer plugin gets a fresh token or a null it can
 * fall back on. Facts verbatim from the page: 127.0.0.1:8787, the GET path,
 * fingerprint-only audit, graceful degradation. Filled surfaces, no borders,
 * scoped CSS, theme-aware via Starlight tokens (docs pages load no Tailwind).
 * Reveal animation is added by script only when motion is allowed, so no-JS
 * and reduced-motion visitors get the static diagram.
 */
---

<div
  class="shflow"
  role="img"
  aria-label="You log in once, by hand. A warm browser stays signed in to the sites you enroll, in its own profile, so each site keeps refreshing its own short-lived token. A broker on 127.0.0.1:8787, reachable from this machine only, answers GET /session/token?site=<host> and logs each handout by the token's fingerprint, never the token. A consumer plugin gets a fresh token and acts, or a null, which means host down, fall back."
>
  <div class="sh-node sh-you" style="--i: 0">
    <span class="sh-title">you</span>
    <span class="sh-sub">log in once, by hand. The one human step.</span>
  </div>

  <span class="sh-arr" aria-hidden="true" style="--i: 0.5">&rarr;</span>

  <div class="sh-node" style="--i: 1">
    <span class="sh-tag">warm browser</span>
    <span class="sh-sub">stays signed in to the sites you enroll, in its own profile, apart from your daily browser</span>
    <span class="sh-fine">each site keeps refreshing its own short-lived token</span>
  </div>

  <span class="sh-arr" aria-hidden="true" style="--i: 1.5">&rarr;</span>

  <div class="sh-node" style="--i: 2">
    <span class="sh-tag">broker &middot; 127.0.0.1:8787</span>
    <span class="sh-sub">answers one question, reachable from this machine only</span>
    <code class="sh-req">GET /session/token?site=&lt;host&gt;</code>
    <span class="sh-fine">every handout logged by fingerprint, never the token</span>
  </div>

  <span class="sh-arr" aria-hidden="true" style="--i: 2.5">&rarr;</span>

  <div class="sh-node sh-consumer" style="--i: 3">
    <span class="sh-tag accent">consumer plugin</span>
    <div class="sh-outcome">
      <code class="sh-out-code ok">&#123; token &#125;</code>
      <span class="sh-out-text">a fresh login, use it</span>
    </div>
    <div class="sh-outcome">
      <code class="sh-out-code">null</code>
      <span class="sh-out-text">host down, fall back</span>
    </div>
  </div>
</div>

<style>
  .shflow {
    display: flex;
    align-items: stretch;
    gap: 0.35rem;
    margin: 1.5rem 0 1.4rem;
  }
  .sh-node {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.85rem 0.9rem 0.9rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 12%, var(--sl-color-bg));
  }
  .sh-you {
    flex: 0 1 9.5rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: color-mix(in oklab, var(--sl-color-text-accent) 20%, var(--sl-color-bg));
  }
  .sh-consumer {
    background: color-mix(in oklab, var(--sl-color-text-accent) 9%, var(--sl-color-bg));
  }
  .sh-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--sl-color-text-accent);
  }
  .sh-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .sh-tag.accent {
    color: var(--sl-color-text-accent);
  }
  .sh-sub {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--sl-color-gray-1);
  }
  .sh-you .sh-sub {
    color: var(--sl-color-gray-1);
    max-width: 9rem;
  }
  .sh-fine {
    font-size: 0.7rem;
    line-height: 1.35;
    color: var(--sl-color-gray-2);
  }
  .sh-req {
    align-self: flex-start;
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    padding: 0.16rem 0.45rem;
    border-radius: 7px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 26%, var(--sl-color-bg));
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }
  .sh-outcome {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .sh-out-code {
    flex: 0 0 auto;
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.12rem 0.42rem;
    border-radius: 7px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 24%, var(--sl-color-bg));
    color: var(--sl-color-gray-1);
  }
  .sh-out-code.ok {
    background: color-mix(in oklab, var(--sl-color-text-accent) 18%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
  }
  .sh-out-text {
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--sl-color-gray-1);
  }
  .sh-arr {
    align-self: center;
    flex: 0 0 auto;
    color: var(--sl-color-gray-1);
    font-size: 1.2rem;
    line-height: 1;
  }

  /* Reveal states, applied only when the script adds .anim (motion allowed). */
  .shflow.anim :is(.sh-node, .sh-arr) {
    opacity: 0;
    transform: translateY(8px);
  }
  .shflow.anim.on :is(.sh-node, .sh-arr) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: calc(var(--i, 0) * 150ms);
  }

  @media (max-width: 760px) {
    .shflow {
      flex-direction: column;
      gap: 0.4rem;
    }
    .sh-you {
      flex: 1 1 auto;
    }
    .sh-you .sh-sub {
      max-width: none;
    }
    .sh-arr {
      transform: rotate(90deg);
    }
    .shflow.anim.on .sh-arr {
      transform: rotate(90deg);
    }
  }
</style>

<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const root of document.querySelectorAll(".shflow")) {
      root.classList.add("anim");
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              root.classList.add("on");
              obs.disconnect();
            }
          }
        },
        { threshold: 0.2 },
      );
      io.observe(root);
    }
  }
</script>
