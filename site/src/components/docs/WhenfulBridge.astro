---
/**
 * Page-specific (whenful): the data-flow map. Three stations show where task
 * data lives and how it moves: Whenful's server, the local mirror + join table
 * in plugins/whenful/, and the note the assistant shows tasks on. The dashed
 * fence between station one and two draws the privacy claim: `sync` is the one
 * thing that crosses the network, reads stay on your machine. Categories only,
 * no invented task data. Filled surfaces, theme tokens, node pills only.
 * The staggered reveal is gated behind prefers-reduced-motion and only arms
 * when JS runs, so without JS everything is simply visible.
 */
---

<div
  class="wfb"
  role="img"
  aria-label="Data flow: tasks live on whenful.com. The sync command is the only network crossing. It fills a local mirror, links.tsv maps each task to a note, and the assistant shows the tasks on the note."
>
  <div class="wfb-station wfb-cloud">
    <span class="wfb-kicker">their server</span>
    <span class="wfb-title">whenful.com</span>
    <span class="wfb-desc">your tasks live here</span>
  </div>

  <div class="wfb-link wfb-fence">
    <span class="wfb-pill">sync</span>
    <span class="wfb-caption">the only network crossing</span>
  </div>

  <div class="wfb-station wfb-local">
    <span class="wfb-kicker">your machine</span>
    <span class="wfb-title"><code>plugins/whenful/</code></span>
    <div class="wfb-files">
      <div class="wfb-file">
        <code>links.tsv</code>
        <span>which task belongs to which note</span>
      </div>
      <div class="wfb-file">
        <code>mirror/&lt;task_id&gt;.md</code>
        <span>a cached copy of each linked task</span>
      </div>
    </div>
  </div>

  <div class="wfb-link wfb-read">
    <span class="wfb-pill wfb-pill-quiet">read</span>
    <span class="wfb-caption">no network, ever</span>
  </div>

  <div class="wfb-station wfb-note">
    <span class="wfb-kicker">your note</span>
    <span class="wfb-title">tasks shown inline</span>
    <span class="wfb-desc">title, state, due date</span>
  </div>
</div>

<style>
  .wfb {
    display: grid;
    grid-template-columns: minmax(0, 5fr) auto minmax(0, 7fr) auto minmax(0, 5fr);
    align-items: stretch;
    gap: 0;
    margin: 1.4rem 0;
    border-radius: 14px;
    padding: 1.1rem 1rem;
    background: color-mix(in oklab, var(--sl-color-gray-3) 8%, var(--sl-color-bg));
    box-shadow: 0 1px 3px color-mix(in oklab, #000 18%, transparent);
  }
  .wfb-station {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    text-align: center;
    padding: 0.9rem 0.8rem;
    border-radius: 12px;
  }
  .wfb-cloud {
    background: color-mix(in oklab, var(--sl-color-gray-3) 16%, var(--sl-color-bg));
  }
  .wfb-local {
    background: color-mix(in oklab, var(--sl-color-text-accent) 8%, var(--sl-color-bg));
  }
  .wfb-note {
    background: color-mix(in oklab, var(--sl-color-gray-3) 16%, var(--sl-color-bg));
  }
  .wfb-kicker {
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .wfb-local .wfb-kicker {
    color: var(--sl-color-text-accent);
  }
  .wfb-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }
  .wfb-title code {
    font-family: var(--sl-font-mono);
    font-size: 0.82rem;
    background: transparent;
    padding: 0;
  }
  .wfb-desc {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
  }
  .wfb-files {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    width: 100%;
  }
  .wfb-file {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.45rem 0.6rem;
    border-radius: 9px;
    background: color-mix(in oklab, var(--sl-color-bg) 72%, transparent);
  }
  .wfb-file code {
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--sl-color-white);
    background: transparent;
    padding: 0;
    overflow-wrap: anywhere;
  }
  .wfb-file span {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--sl-color-gray-2);
  }
  /* Connectors: a line the pill sits on. The first one is the network fence,
     drawn dashed. The second is a plain local read, drawn solid and quiet. */
  .wfb-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0 0.9rem;
    min-width: 5.4rem;
  }
  .wfb-link::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: 2px solid color-mix(in oklab, var(--sl-color-gray-3) 55%, transparent);
  }
  .wfb-fence::before {
    border-top-style: dashed;
    border-top-color: color-mix(in oklab, var(--sl-color-text-accent) 55%, transparent);
  }
  /* arrowhead pointing into the next station */
  .wfb-link::after {
    content: "";
    position: absolute;
    right: -1px;
    top: 50%;
    transform: translateY(-50%);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 7px solid color-mix(in oklab, var(--sl-color-gray-3) 80%, var(--sl-color-gray-2));
  }
  .wfb-fence::after {
    border-left-color: color-mix(in oklab, var(--sl-color-text-accent) 80%, transparent);
  }
  .wfb-pill {
    position: relative;
    z-index: 1;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.18rem 0.62rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 22%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
  }
  .wfb-pill-quiet {
    background: color-mix(in oklab, var(--sl-color-gray-3) 30%, var(--sl-color-bg));
    color: var(--sl-color-gray-1);
  }
  .wfb-caption {
    position: relative;
    z-index: 1;
    font-size: 0.62rem;
    line-height: 1.3;
    text-align: center;
    color: var(--sl-color-gray-2);
    background: color-mix(in oklab, var(--sl-color-gray-3) 8%, var(--sl-color-bg));
    padding: 0.1rem 0.3rem;
    border-radius: 6px;
  }
  /* staggered reveal, armed by JS only */
  .wfb-armed .wfb-station,
  .wfb-armed .wfb-link {
    opacity: 0;
    transform: translateY(9px);
  }
  .wfb-in .wfb-station,
  .wfb-in .wfb-link {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
  .wfb-in > :nth-child(2) { transition-delay: 0.12s; }
  .wfb-in > :nth-child(3) { transition-delay: 0.24s; }
  .wfb-in > :nth-child(4) { transition-delay: 0.36s; }
  .wfb-in > :nth-child(5) { transition-delay: 0.48s; }

  @media (max-width: 660px) {
    .wfb {
      grid-template-columns: 1fr;
      padding: 0.9rem;
    }
    .wfb-link {
      min-height: 4.6rem;
      padding: 0.5rem 0;
    }
    /* the line turns vertical, the arrow points down */
    .wfb-link::before {
      left: 50%;
      right: auto;
      top: 0;
      bottom: 0;
      border-top: 0;
      border-left: 2px solid color-mix(in oklab, var(--sl-color-gray-3) 55%, transparent);
    }
    .wfb-fence::before {
      border-left-style: dashed;
      border-left-color: color-mix(in oklab, var(--sl-color-text-accent) 55%, transparent);
    }
    .wfb-link::after {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1px;
      transform: translateX(-50%);
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-bottom: 0;
      border-top: 7px solid color-mix(in oklab, var(--sl-color-gray-3) 80%, var(--sl-color-gray-2));
    }
    .wfb-fence::after {
      border-top-color: color-mix(in oklab, var(--sl-color-text-accent) 80%, transparent);
    }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const root of document.querySelectorAll<HTMLElement>(".wfb")) {
    if (reduce || !("IntersectionObserver" in window)) continue;
    root.classList.add("wfb-armed");
    new IntersectionObserver(
      (entries, obs) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        obs.disconnect();
        root.classList.add("wfb-in");
      },
      { threshold: 0.3 },
    ).observe(root);
  }
</script>
