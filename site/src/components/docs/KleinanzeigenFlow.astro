---
/**
 * kleinanzeigen page ONLY - the hero flow. Two read-only lanes (your message
 * box, the marketplace) converge on the human gate, and only past the gate does
 * a send command exist. Replaces the old ASCII seam diagram with the same
 * facts: sync mirrors conversations to local files, rate sorts with fixed
 * rules, notify ships the digest, watch run re-fetches and diffs saved
 * searches, and send/contact each post exactly one message. Filled surfaces,
 * no borders, scoped CSS, theme-aware via Starlight tokens (docs pages load no
 * Tailwind). Reveal animation is added by script only when motion is allowed,
 * so no-JS and reduced-motion visitors get the static diagram.
 */
const LANES = [
  {
    tag: "your message box",
    steps: [
      { cmd: "sync", sub: "mirrors every conversation to local files" },
      { cmd: "rate", sub: "fixed rules sort each thread, no AI" },
      { cmd: "notify", sub: "ships the phone-sized digest" },
    ],
  },
  {
    tag: "the marketplace",
    steps: [
      { cmd: "watch run", sub: "re-fetches each saved search" },
      { cmd: "diff", sub: "compares against the last snapshot" },
      { cmd: "deal digest", sub: "new, price drop, gone" },
    ],
  },
];
const SENDS = [
  { cmd: "send", sub: "posts one reply into a thread" },
  { cmd: "contact", sub: "opens one new conversation" },
];
---

<div
  class="kflow"
  role="img"
  aria-label="Two read-only lanes feed a human gate. In the message box lane, sync mirrors every conversation to local files, rate sorts each thread with fixed rules and no AI, and notify ships the phone-sized digest. In the marketplace lane, watch run re-fetches each saved search, diff compares it against the last snapshot, and a deal digest reports new, price drop, and gone. You read the digest and give the okay. Only then does a send command run: send posts one reply into a thread, contact opens one new conversation."
>
  <div class="zone read" style="--i: 0">
    <span class="zlabel">reads · code only, no AI</span>
    <div class="lanes">
      {
        LANES.map((lane, li) => (
          <div class="lane">
            <span class="ltag">{lane.tag}</span>
            <div class="steps">
              {lane.steps.map((s, si) => (
                <>
                  <div class="step" style={`--i: ${li * 0.5 + si}`}>
                    <span class="cmd">{s.cmd}</span>
                    <span class="sub">{s.sub}</span>
                  </div>
                  {si < lane.steps.length - 1 && (
                    <span class="arr" aria-hidden="true">
                      &rarr;
                    </span>
                  )}
                </>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <span class="bigarr" aria-hidden="true" style="--i: 3">&rarr;</span>

  <div class="gate" style="--i: 3.5">
    <span class="you">you</span>
    <span class="gsub">read, tweak, okay</span>
  </div>

  <span class="bigarr" aria-hidden="true" style="--i: 4">&rarr;</span>

  <div class="zone sendzone" style="--i: 4.5">
    <span class="zlabel accent">sends · your hand only</span>
    <div class="sends">
      {
        SENDS.map((s, si) => (
          <div class="send" style={`--i: ${4.5 + si * 0.5}`}>
            <span class="cmd">{s.cmd}</span>
            <span class="sub">{s.sub}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .kflow {
    display: flex;
    align-items: stretch;
    gap: 0.35rem;
    margin: 1.5rem 0 1.2rem;
  }
  .zone {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0.85rem 0.9rem 0.9rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 10%, var(--sl-color-bg));
    margin-top: 0;
  }
  .zone.read {
    flex: 1 1 auto;
    min-width: 0;
  }
  .zone.sendzone {
    flex: 0 0 auto;
    background: color-mix(in oklab, var(--sl-color-text-accent) 8%, var(--sl-color-bg));
  }
  .zlabel {
    font-family: var(--sl-font);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .zlabel.accent {
    color: var(--sl-color-text-accent);
  }
  .lanes {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
    justify-content: space-around;
  }
  .lane {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .ltag {
    font-family: var(--sl-font);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .steps {
    display: flex;
    align-items: stretch;
    gap: 0.3rem;
  }
  .step {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    padding: 0.55rem 0.65rem 0.6rem;
    border-radius: 10px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 20%, var(--sl-color-bg));
  }
  .cmd {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .sub {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--sl-color-gray-2);
  }
  .arr {
    align-self: center;
    flex: 0 0 auto;
    color: var(--sl-color-gray-3);
    font-size: 0.95rem;
  }
  .bigarr {
    align-self: center;
    flex: 0 0 auto;
    color: var(--sl-color-gray-1);
    font-size: 1.35rem;
  }
  .gate {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.9rem 0.8rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 20%, var(--sl-color-bg));
    margin-top: 0;
  }
  .you {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--sl-color-text-accent);
  }
  .gsub {
    font-size: 0.68rem;
    line-height: 1.3;
    text-align: center;
    max-width: 6.5rem;
    color: var(--sl-color-gray-1);
  }
  .sends {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
    justify-content: space-around;
  }
  .send {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    padding: 0.55rem 0.7rem 0.6rem;
    border-radius: 10px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 17%, var(--sl-color-bg));
    max-width: 13rem;
  }
  .send .cmd {
    color: var(--sl-color-text-accent);
  }
  .send .sub {
    color: var(--sl-color-gray-1);
  }

  /* Reveal states, applied only when the script adds .anim (motion allowed). */
  .kflow.anim :is(.zone, .gate, .bigarr) {
    opacity: 0;
    transform: translateY(10px);
  }
  .kflow.anim .step,
  .kflow.anim .send {
    opacity: 0;
    transform: translateY(6px);
  }
  .kflow.anim.on :is(.zone, .gate, .bigarr, .step, .send) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: calc(var(--i, 0) * 130ms);
  }

  @media (max-width: 760px) {
    .kflow {
      flex-direction: column;
      gap: 0.4rem;
    }
    .steps {
      flex-direction: column;
      gap: 0.25rem;
    }
    .arr {
      transform: rotate(90deg);
      font-size: 0.85rem;
      line-height: 1;
    }
    .kflow.anim.on .arr {
      transform: rotate(90deg);
    }
    .bigarr {
      transform: rotate(90deg);
      line-height: 1;
    }
    .kflow.anim.on .bigarr {
      transform: rotate(90deg);
    }
    .gate {
      flex-direction: row;
      justify-content: center;
      gap: 0.7rem;
      padding: 0.7rem 0.9rem;
    }
    .gsub {
      max-width: none;
      text-align: left;
    }
    .zone.sendzone {
      flex: 1 1 auto;
    }
    .send {
      max-width: none;
    }
  }
</style>

<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const root of document.querySelectorAll(".kflow")) {
      root.classList.add("anim");
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              root.classList.add("on");
              obs.disconnect();
            }
          }
        },
        { threshold: 0.15 },
      );
      io.observe(root);
    }
  }
</script>
