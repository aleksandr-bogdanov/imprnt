---
/**
 * The one rule, pulled out of prose into a single highlighted banner so the eye
 * lands on it. Borderless: a filled accent surface, the litmus line in large
 * type. It sits right under the kinds diagram, whose "edits to core: 0" counter
 * is this rule running live, so the "zero edits" phrase carries the accent.
 * Scoped CSS, theme-aware via Starlight tokens (no Tailwind on docs pages).
 * The entrance rise is scroll-gated by a tiny IntersectionObserver and skipped
 * under reduced motion or without JS.
 */
---

<div class="banner reveal">
  <span class="label">the one rule</span>
  <p class="line">
    You can add or remove any plugin with <strong>zero edits</strong> to core code.
  </p>
  <p class="sub">If a plugin forces a core edit, the plugin is wrong. That is what stops imprnt from growing to know about every add-on, the rot that bloats this kind of system over time.</p>
</div>

<style>
  .banner {
    margin: 1.6rem 0;
    padding: 1.3rem 1.5rem;
    border-radius: 16px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 13%, var(--sl-color-bg));
  }
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.22, 0.65, 0.3, 1);
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }
  .label {
    display: inline-block;
    font-family: var(--sl-font);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
    margin-bottom: 0.5rem;
  }
  .line {
    margin: 0;
    font-family: var(--sl-font);
    font-size: 1.3rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .line strong {
    color: var(--sl-color-text-accent);
    font-weight: 700;
  }
  .sub {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  /* with scripts off the observer never fires, so never hide the content */
  @media (scripting: none) {
    .reveal {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 640px) {
    .line {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  // scroll-gated entrance: reveal immediately under reduced motion or when
  // IntersectionObserver is missing, otherwise rise in on first view
  const els = document.querySelectorAll(".banner.reveal");
  if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
    for (const el of els) el.classList.add("in");
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) {
            e.target.classList.add("in");
            io.unobserve(e.target);
          }
      },
      { threshold: 0.15 },
    );
    for (const el of els) io.observe(el);
  }
</script>
