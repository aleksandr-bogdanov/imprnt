---
/**
 * Page-specific (character) visual: the defining facts of a behavior plugin,
 * pulled out of the How-it-works prose. A compact "what it touches" row that
 * makes "no code, no command, no data" land at a glance. Categories, not
 * instances. Filled surfaces, no borders. Scoped CSS, theme-aware via tokens.
 */
const TOUCHES = [
  { label: "code", on: false },
  { label: "command", on: false },
  { label: "data", on: false },
  { label: "the prompt", on: true },
];
---

<div class="touches">
  <span class="lead">A behavior plugin touches</span>
  <div class="chips">
    {
      TOUCHES.map((t) => (
        <span class={`chip${t.on ? " on" : ""}`}>
          <span class="mark" aria-hidden="true">{t.on ? "✓" : "✕"}</span>
          {t.label}
        </span>
      ))
    }
  </div>
  <p class="note">
    It hands the assistant a character file you wire into its prompt. Your vault
    never force-feeds the assistant.
  </p>
</div>

<style>
  .touches {
    margin: 1.3rem 0 1.5rem;
    border-radius: 14px;
    padding: 1.05rem 1.2rem 1.15rem;
    background: color-mix(in oklab, var(--sl-color-gray-3) 13%, var(--sl-color-bg));
  }
  .lead {
    display: block;
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    margin-bottom: 0.6rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.32rem 0.7rem;
    border-radius: 9px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 22%, var(--sl-color-bg));
    color: var(--sl-color-gray-1);
  }
  .chip.on {
    background: color-mix(in oklab, var(--sl-color-text-accent) 15%, var(--sl-color-bg));
    color: var(--sl-color-white);
  }
  .mark {
    font-size: 0.82rem;
    color: var(--sl-color-gray-2);
  }
  .chip.on .mark {
    color: var(--sl-color-text-accent);
  }
  .note {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--sl-color-gray-1);
  }
</style>
