---
/**
 * imprnt's four bets, each the minority position in the field. Borderless cards:
 * the bet, what the field mostly does, who comes closest. Scoped CSS, no Tailwind.
 */
const BETS = [
  {
    bet: "No embeddings.",
    body: "Search is BM25 plus grep, local arithmetic, no model in the read loop.",
    field: "Embeddings and a vector index as the core recall driver. Every other tool ships them.",
    closest: "Basic Memory keeps a full-text mode, but defaults to hybrid vector. Nobody else defaults to no vectors.",
  },
  {
    bet: "Conscious capture.",
    body: "You decide what gets filed, on demand.",
    field: "Auto-extraction from every chat turn.",
    closest: "Basic Memory and Karpathy's LLM Wiki also capture on a deliberate write. The rest auto-capture.",
  },
  {
    bet: "No server over the vault.",
    body: "The AI greps the Markdown directly.",
    field: "An MCP server or a vector DB sits between the AI and the data.",
    closest: "Karpathy's LLM Wiki, also serverless. Most Markdown-native tools still put a derived index and a protocol in between.",
  },
  {
    bet: "Spend the model only where it runs rarely.",
    body: "On the write path, never the read path.",
    field: "Optimize read-side scores, often with a model on every query.",
    closest: "Not a framing anyone else leads with. The benchmark leaders push the opposite way.",
  },
];
---

<div class="bets">
  {
    BETS.map((b) => (
      <div class="bet">
        <p class="bet-title">{b.bet}</p>
        <p class="bet-body">{b.body}</p>
        <div class="bet-row">
          <span class="bet-label">the field</span>
          <span class="bet-text">{b.field}</span>
        </div>
        <div class="bet-row">
          <span class="bet-label">closest</span>
          <span class="bet-text">{b.closest}</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  .bets {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
    margin: 1.5rem 0;
  }
  @media (max-width: 720px) {
    .bets {
      grid-template-columns: 1fr;
    }
  }

  .bet {
    border-radius: 14px;
    padding: 1.1rem 1.2rem;
    background: color-mix(in oklab, var(--sl-color-text-accent) 7%, var(--sl-color-bg));
  }
  .bet-title {
    margin: 0;
    font-family: var(--sl-font);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--sl-color-text-accent);
  }
  .bet-body {
    margin: 0.35rem 0 0.85rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--sl-color-white);
  }
  .bet-row {
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 0.6rem;
    padding: 0.5rem 0 0;
  }
  .bet-row + .bet-row {
    margin-top: 0.1rem;
  }
  .bet-label {
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    padding-top: 0.1rem;
  }
  .bet-text {
    font-size: 0.83rem;
    line-height: 1.45;
    color: var(--sl-color-gray-2);
  }
</style>
