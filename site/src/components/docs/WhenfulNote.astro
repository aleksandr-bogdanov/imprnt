---
/**
 * Page-specific (whenful): the payoff mock. A vault note card with its Whenful
 * tasks shown inline under the note body, exactly the three fields the plugin
 * surfaces (title, state, due date) plus the optional step label from the join
 * table, so the reader sees what "tasks on the note" means before any plumbing.
 * Note prose is skeleton bars (no invented content), task values are clearly
 * illustrative example data. Filled surfaces, theme tokens, no border boxes
 * (the open-state ring is a node marker, allowed).
 */
const TASKS = [
  { title: "Export the old notes", state: "done", due: "", step: "" },
  { title: "Ship the CSV importer", state: "in progress", due: "due Fri", step: "importer" },
  { title: "Re-run check on the full vault", state: "open", due: "due Jun 12", step: "" },
];
const slug = (s: string) => s.replace(/\s+/g, "-");
---

<div
  class="wf-note"
  role="img"
  aria-label="A vault note with its Whenful tasks shown inline: each task's title, state, and due date."
>
  <div class="wf-note-head">
    <span class="wf-note-path">projects/vault-migration.md</span>
    <span class="wf-note-hint">your note</span>
  </div>
  <div class="wf-note-body">
    <span class="wf-note-title">Vault migration</span>
    <span class="wf-bar" style="width:88%"></span>
    <span class="wf-bar" style="width:72%"></span>
    <span class="wf-bar" style="width:55%"></span>
  </div>
  <div class="wf-tasks">
    <span class="wf-tasks-label">tasks &middot; from whenful</span>
    {
      TASKS.map((t) => (
        <div class="wf-task">
          <span class={`wf-dot wf-dot-${slug(t.state)}`} aria-hidden="true" />
          <span class="wf-task-title">{t.title}</span>
          <span class="wf-task-meta">
            {t.step && <span class="wf-chip wf-chip-step">step: {t.step}</span>}
            {t.due && <span class="wf-chip">{t.due}</span>}
            <span class={`wf-state wf-state-${slug(t.state)}`}>{t.state}</span>
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .wf-note {
    margin: 1.4rem 0;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 10%, var(--sl-color-bg));
    box-shadow: 0 1px 3px color-mix(in oklab, #000 18%, transparent);
    overflow: hidden;
  }
  .wf-note-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.55rem 1rem;
    background: color-mix(in oklab, var(--sl-color-gray-3) 18%, var(--sl-color-bg));
  }
  .wf-note-path {
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    color: var(--sl-color-gray-2);
    overflow-wrap: anywhere;
  }
  .wf-note-hint {
    flex: 0 0 auto;
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .wf-note-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.95rem 1rem 1rem;
  }
  .wf-note-title {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin-bottom: 0.15rem;
  }
  .wf-bar {
    height: 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 26%, var(--sl-color-bg));
  }
  .wf-tasks {
    padding: 0.75rem 1rem 0.95rem;
    background: color-mix(in oklab, var(--sl-color-text-accent) 7%, var(--sl-color-bg));
  }
  .wf-tasks-label {
    display: block;
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
    margin-bottom: 0.55rem;
  }
  .wf-task {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem 0.55rem;
    padding: 0.42rem 0;
  }
  .wf-task + .wf-task {
    border-top: 1px solid color-mix(in oklab, var(--sl-color-gray-3) 22%, transparent);
  }
  .wf-dot {
    flex: 0 0 auto;
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
  }
  .wf-dot-done {
    background: #7fb069;
  }
  .wf-dot-in-progress {
    background: #d9a95c;
  }
  .wf-dot-open {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--sl-color-gray-3);
  }
  .wf-task-title {
    font-size: 0.88rem;
    color: var(--sl-color-white);
  }
  .wf-task-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
  }
  .wf-chip {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 20%, var(--sl-color-bg));
    color: var(--sl-color-gray-1);
    white-space: nowrap;
  }
  .wf-chip-step {
    background: color-mix(in oklab, var(--sl-color-text-accent) 14%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
  }
  .wf-state {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    white-space: nowrap;
  }
  .wf-state-done {
    color: #7fb069;
  }
  .wf-state-in-progress {
    color: #d9a95c;
  }
  .wf-state-open {
    color: var(--sl-color-gray-2);
  }
  @media (max-width: 560px) {
    .wf-task-meta {
      margin-left: 1.17rem;
      flex-basis: 100%;
    }
  }
</style>
