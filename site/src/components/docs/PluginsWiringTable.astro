---
/**
 * Page-specific to docs/plugins.mdx. The same agent.md fragment loads either for
 * one project or for every session; this lays the two choices side by side as
 * filled lanes, each carrying its verbatim commands and the four facts that
 * differ (where it wires in, the sessions it reaches, how to remove it). It
 * replaces the prose paragraph that used to repeat the same project-vs-global
 * split. Borderless filled surfaces, scoped CSS, theme-aware via Starlight tokens
 * (no Tailwind on docs pages). All commands are verbatim.
 */
const LANES = [
  {
    scope: "project",
    blurb: "the default",
    add: "imprnt plugin add <name>",
    note: "",
    where: "CLAUDE.local.md, per-machine, never committed",
    // a string with a {cmd} placeholder so the CLI command renders monospace,
    // matching how the rest of the docs write it in backticks
    reaches: "this project's sessions, plus every {cmd} session (it inlines the project's plugins from any directory)",
    cmd: "imp",
    remove: "imprnt plugin rm <name>",
    accent: false,
  },
  {
    scope: "global",
    blurb: "a house style like anti-slop",
    add: "imprnt global add <name>",
    note: "promotes an installed project plugin (or pass --from <dir>)",
    where: "registered with imprnt, never your ~/.claude/CLAUDE.md",
    reaches: "every session {cmd} launches, even with no vault project",
    cmd: "imp",
    remove: "imprnt global rm <name>",
    accent: true,
  },
];
---

<div class="wiring">
  {
    LANES.map((l) => (
      <div class={`lane${l.accent ? " accent" : ""}`}>
        <div class="head">
          <span class="scope">{l.scope}</span>
          <span class="blurb">{l.blurb}</span>
        </div>
        <div class="flow">
          <span class="chip">agent.md</span>
          <span class="arr" aria-hidden="true">&rarr;</span>
          <span class="dest">
            {l.reaches.includes("{cmd}")
              ? (() => {
                  const [pre, post] = l.reaches.split("{cmd}");
                  return (
                    <>
                      {pre}
                      <code class="destcmd">{l.cmd}</code>
                      {post}
                    </>
                  );
                })()
              : l.reaches}
          </span>
        </div>
        <dl class="facts">
          <div class="fact">
            <dt>add</dt>
            <dd>
              <code>{l.add}</code>
              {l.note && <span class="note">{l.note}</span>}
            </dd>
          </div>
          <div class="fact">
            <dt>wires in</dt>
            <dd>{l.where}</dd>
          </div>
          <div class="fact">
            <dt>remove</dt>
            <dd><code>{l.remove}</code></dd>
          </div>
        </dl>
      </div>
    ))
  }
</div>

<style>
  .wiring {
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* one shared row track per visual row (head, flow, 3 facts) so the two
       lanes stay in register even when one lane's text wraps to two lines */
    grid-template-rows: auto auto auto auto auto;
    align-items: stretch;
    gap: 0.85rem;
    margin: 1.5rem 0;
  }
  .lane {
    display: grid;
    grid-row: 1 / -1;
    align-self: stretch;
    height: 100%;
    grid-template-rows: subgrid;
    /* every row's content sits at the top of its shared track, so when one
       lane's wires-in text wraps taller the other lane's same-row label still
       starts at the identical y */
    align-content: start;
    justify-items: stretch;
    row-gap: 0.7rem;
    border-radius: 15px;
    padding: 1.05rem 1.2rem;
    /* PROJECT is the local default: a clearly neutral gray surface, so a glance
       reads "this machine" without parsing the caption */
    background: color-mix(in oklab, var(--sl-color-gray-3) 26%, var(--sl-color-bg));
  }
  .lane > * {
    align-self: start;
  }
  .facts {
    display: contents;
  }
  /* GLOBAL is the house-style scope: a distinctly green surface, so the two
     scopes never read as the same card */
  .lane.accent {
    background: color-mix(in oklab, var(--sl-color-text-accent) 17%, var(--sl-color-bg));
  }
  .head {
    /* scope eyebrow on its own line, blurb on the next, identical two-row shape
       in both lanes. the old single-row flex let the longer GLOBAL blurb wrap to
       two lines while PROJECT's stayed one, so the GLOBAL head rendered taller
       and pushed its card top ~32px lower. a fixed two-line block makes both
       heads the same height, so the card tops and every labelled row below land
       on the same y left to right */
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    min-height: 2.75rem;
  }
  .scope {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--sl-color-gray-2);
  }
  .lane.accent .scope {
    color: var(--sl-color-text-accent);
  }
  .blurb {
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
  }
  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
  }
  .chip {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    padding: 0.2rem 0.5rem;
    border-radius: 7px;
    background: color-mix(in oklab, var(--sl-color-gray-2) 26%, var(--sl-color-bg));
    color: var(--sl-color-gray-1);
  }
  .lane.accent .chip {
    /* the chip sits on the card's green tint, so a faint green fill vanishes.
       darken the fill and add a 1px boundary so the chip reads as a crisp box,
       matching the chip affordance on the gray PROJECT card */
    background: color-mix(in oklab, var(--sl-color-text-accent) 30%, var(--sl-color-bg));
    border: 1px solid color-mix(in oklab, var(--sl-color-text-accent) 50%, transparent);
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .arr {
    color: var(--sl-color-gray-4);
    font-size: 0.9rem;
  }
  .dest {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .destcmd {
    font-family: var(--sl-font-mono);
    font-size: 0.85em;
    font-weight: 700;
    padding: 0.05rem 0.32rem;
    border-radius: 6px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 16%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
  }
  .lane:not(.accent) .destcmd {
    background: color-mix(in oklab, var(--sl-color-gray-3) 20%, var(--sl-color-bg));
    color: var(--sl-color-white);
  }
  .fact {
    margin: 0;
    align-self: start;
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 0.2rem 0.7rem;
    align-items: baseline;
  }
  .fact dt {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .fact dd {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--sl-color-gray-1);
  }
  .fact code {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    padding: 0.1rem 0.35rem;
    border-radius: 6px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 16%, var(--sl-color-bg));
    color: var(--sl-color-white);
  }
  /* fine print under a command, e.g. the promote-vs---from caveat on global add */
  .fact .note {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.74rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
  }
  /* on the green GLOBAL card the gray chip fill drops nearly invisible, so give
     the command chips a darker fill and a defined 1px boundary, the same crisp
     box they get on the gray PROJECT card */
  .lane.accent .fact code {
    background: color-mix(in oklab, var(--sl-color-gray-3) 30%, var(--sl-color-bg));
    border: 1px solid color-mix(in oklab, var(--sl-color-gray-2) 34%, transparent);
  }
  @media (max-width: 640px) {
    .wiring {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    /* lanes stack one above the other on a phone, so each lane lays out its own
       rows instead of sharing a cross-card subgrid. tighten the inter-row gap so
       the facts read as one compact spec block, not a loose stack */
    .lane {
      grid-row: auto;
      grid-template-rows: none;
      grid-auto-rows: max-content;
      row-gap: 0.45rem;
    }
    /* keep label and value on one line (label: value) with a narrow auto-width
       label, so the value sits right next to its label near the card's left edge
       instead of indented on its own line. a long value wraps under itself, still
       hugging the left edge rather than under a wide empty label column */
    .fact {
      grid-template-columns: auto 1fr;
      gap: 0 0.5rem;
      align-items: baseline;
    }
    .fact dt {
      white-space: nowrap;
    }
  }
</style>
