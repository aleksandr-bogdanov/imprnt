---
/**
 * Page-specific (design-decisions). The recurring throughline made visible: PAI
 * went one way, imprnt commits to the other. A two-column contrast badge so the
 * repeated "PAI did X, imprnt flips it" beat reads as a recognizable pattern
 * instead of the same paragraph rewritten. Props carry the pair. Borderless
 * tinted surfaces, an arrow between. Scoped CSS, theme-aware, no Tailwind.
 */
interface Props {
  pai: string;
  imprnt: string;
}
const { pai, imprnt } = Astro.props;
---

<div class="paiflip">
  <div class="paiflip-col paiflip-from">
    <span class="paiflip-tag">PAI</span>
    <span class="paiflip-text">{pai}</span>
  </div>
  <span class="paiflip-arrow" aria-hidden="true">&rarr;</span>
  <div class="paiflip-col paiflip-to">
    <span class="paiflip-tag">imprnt</span>
    <span class="paiflip-text">{imprnt}</span>
  </div>
</div>

<style>
  .paiflip {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 0.6rem;
    margin: 1.2rem 0;
  }
  .paiflip-col {
    border-radius: 12px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .paiflip-from {
    background: color-mix(in oklab, var(--sl-color-gray-4) 45%, var(--sl-color-bg));
  }
  .paiflip-to {
    background: color-mix(in oklab, var(--sl-color-text-accent) 11%, var(--sl-color-bg));
  }
  .paiflip-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .paiflip-to .paiflip-tag {
    color: var(--sl-color-text-accent);
  }
  .paiflip-text {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--sl-color-white);
  }
  .paiflip-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    color: var(--sl-color-text-accent);
  }
  @media (max-width: 640px) {
    .paiflip {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .paiflip-arrow {
      transform: rotate(90deg);
      padding: 0.1rem 0;
    }
  }
</style>
