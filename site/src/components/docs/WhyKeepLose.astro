---
/**
 * Page-specific (why-imprnt): the same fact stored two ways, as two alternatives
 * side by side. Left: a note in your vault, readable, one line to fix, a folder
 * you take with you. Right: the same fact as rows of numbers in a machine-store,
 * nothing to read, no line to fix, an export if the tool allows one. Each card
 * is complete on its own: a preview of the stored thing, then three plain
 * consequences. Sans only, filled surfaces, no border boxes. Scoped CSS,
 * theme-aware via Starlight tokens, no Tailwind. Reveal animation is additive:
 * no JS or reduced motion renders fully visible.
 */
const NOTE = [
  { k: "h", t: "Dr. Weber" },
  { k: "m", t: "tags: health, cardiology" },
  { k: "m", t: "summary: My cardiologist since 2024." },
  { k: "b", t: "Moved her practice to Friedrichstrasse in May. Next checkup due in October." },
];

const VEC = [
  "0.0132  -0.8841  0.5590  -0.1127",
  "-0.4203  0.7719  -0.0865  0.3341",
  "0.9034  -0.2210  0.6402  -0.5577",
  "-0.1848  0.4466  -0.9152  0.0719",
];

const KEEP = [
  "Open it like any text file and read it.",
  "A wrong fact is one line. Edit it, done.",
  "Switch assistants: the folder comes with you.",
];
const LOSE = [
  "Rows of numbers. Nothing to read.",
  "A wrong fact has no line to find.",
  "Switch assistants: export first, if the tool allows.",
];
---

<div class="kl" data-kl>
  <span class="kl-tag">the same fact, stored two ways</span>
  <div class="kl-cards">
    <figure class="kl-fig keep" style="--d: 0ms">
      <figcaption class="kl-cap">A note in your vault</figcaption>
      <div class="kl-preview" role="img" aria-label="A plain text note: Dr. Weber, tagged health and cardiology, a summary line, and the fact that she moved her practice to Friedrichstrasse in May.">
        <span class="kl-path">people/dr-weber.md</span>
        {NOTE.map((l) => <span class={`ln ln-${l.k}`}>{l.t}</span>)}
      </div>
      <ul class="kl-list">
        {KEEP.map((t) => <li><span class="mark ok" aria-hidden="true">&#10003;</span>{t}</li>)}
      </ul>
    </figure>
    <figure class="kl-fig lose" style="--d: 140ms">
      <figcaption class="kl-cap">The same fact in a machine-store</figcaption>
      <div class="kl-preview" role="img" aria-label="The same fact converted to rows of decimal numbers. No sentence survives the conversion.">
        <span class="kl-path">memory.index</span>
        <span class="kl-nums" aria-hidden="true">
          {VEC.map((r) => <span class="vr">{r}</span>)}
          <span class="vr more">and hundreds more</span>
        </span>
      </div>
      <ul class="kl-list">
        {LOSE.map((t) => <li><span class="mark no" aria-hidden="true">&#10005;</span>{t}</li>)}
      </ul>
    </figure>
  </div>
</div>

<style>
  .kl {
    margin: 1.7rem 0;
  }
  .kl-tag {
    display: block;
    font-family: var(--sl-font);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.8rem;
  }
  .kl-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }
  .kl-fig {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-radius: 13px;
    padding: 0.95rem 1rem 1rem;
  }
  .kl-fig.keep {
    background: color-mix(in oklab, var(--sl-color-text-accent) 10%, var(--sl-color-bg));
  }
  .kl-fig.lose {
    background: color-mix(in oklab, var(--sl-color-gray-4) 45%, var(--sl-color-bg));
  }
  .kl-cap {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 0.65rem;
  }
  .lose .kl-cap {
    color: var(--sl-color-gray-1);
  }
  .kl-preview {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    border-radius: 10px;
    padding: 0.7rem 0.8rem 0.8rem;
    background: color-mix(in oklab, var(--sl-color-bg) 70%, transparent);
  }
  .kl-path {
    align-self: flex-start;
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    padding: 0.14rem 0.5rem;
    border-radius: 7px;
    margin-bottom: 0.45rem;
    color: var(--sl-color-white);
    background: color-mix(in oklab, var(--sl-color-text-accent) 16%, var(--sl-color-bg));
  }
  .lose .kl-path {
    color: var(--sl-color-gray-2);
    background: color-mix(in oklab, var(--sl-color-gray-3) 22%, var(--sl-color-bg));
  }
  .ln {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--sl-color-white);
  }
  .ln-h {
    font-weight: 700;
  }
  .ln-m {
    color: var(--sl-color-gray-2);
  }
  .ln-b {
    margin-top: 0.3rem;
  }
  .kl-nums {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }
  .vr {
    font-size: 0.8rem;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
    white-space: pre;
    color: var(--sl-color-gray-2);
  }
  .vr.more {
    color: var(--sl-color-gray-3);
  }
  .kl-list {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .kl-list li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 0.86rem;
    line-height: 1.42;
    color: var(--sl-color-white);
  }
  .lose .kl-list li {
    color: var(--sl-color-gray-1);
  }
  .mark {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .mark.ok {
    color: var(--sl-color-text-accent);
  }
  .mark.no {
    color: var(--sl-color-gray-3);
  }

  /* reveal: armed only by JS, so no-JS and reduced-motion render static */
  .kl.armed .kl-fig {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.55s ease var(--d),
      transform 0.55s ease var(--d);
  }
  .kl.armed.in .kl-fig {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 700px) {
    .kl-cards {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const reducedKl = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll("[data-kl]").forEach((el) => {
    if (reducedKl || !("IntersectionObserver" in window)) return;
    el.classList.add("armed");
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            el.classList.add("in");
            io.disconnect();
          }
        }
      },
      { threshold: 0.12 },
    );
    io.observe(el);
  });
</script>
