---
/**
 * Page-specific (how-it-works): the imprnt loop as a legible flow.
 * Five nodes, big labels, reads left-to-right on desktop and stacks vertically
 * on mobile. Each node is tagged by actor (you / model / code) so the reader
 * sees where the model is spent and where plain code carries the work.
 * No borders. Scoped CSS, theme-aware via Starlight tokens. Replaces the dense
 * D2 architecture SVG, which was illegible at both sizes.
 */
const NODES = [
  { label: "You", sub: "talk in plain words", who: "you" },
  { label: "File once", sub: "the model understands and sorts", who: "model" },
  { label: "Vault", sub: "plain markdown on your disk", who: "store" },
  { label: "Recall", sub: "plain code ranks, no model", who: "code" },
  { label: "Answer", sub: "the model reads the best hits", who: "model" },
];
---

<div class="flow" role="img" aria-label="The imprnt loop: you talk, the model files once, the vault stores plain markdown, plain code recalls the best notes, the model reads them and answers.">
  {
    NODES.map((n, i) => (
      <>
        <div class={`node ${n.who}`}>
          <span class="who-tag">{n.who === "store" ? "on disk" : n.who}</span>
          <span class="label">{n.label}</span>
          <span class="sub">{n.sub}</span>
        </div>
        {i < NODES.length - 1 && (
          <span class="arr" aria-hidden="true">&rarr;</span>
        )}
      </>
    ))
  }
</div>

<style>
  .flow {
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
    margin: 1.5rem 0;
  }
  .node {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.95rem 0.85rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 12%, var(--sl-color-bg));
  }
  .node.model {
    background: color-mix(in oklab, var(--sl-color-text-accent) 12%, var(--sl-color-bg));
  }
  .node.code {
    background: color-mix(in oklab, var(--sl-color-gray-3) 22%, var(--sl-color-bg));
  }
  .who-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .node.model .who-tag {
    color: var(--sl-color-text-accent);
  }
  .label {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--sl-color-white);
  }
  .sub {
    font-size: 0.82rem;
    line-height: 1.3;
    color: var(--sl-color-gray-1);
  }
  .arr {
    align-self: center;
    color: var(--sl-color-gray-3);
    font-size: 1.3rem;
    flex: 0 0 auto;
  }
  @media (max-width: 640px) {
    .flow {
      flex-direction: column;
      gap: 0.35rem;
    }
    .node {
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.25rem 0.55rem;
      padding: 0.8rem 0.95rem;
    }
    .who-tag {
      order: -1;
      flex-basis: 100%;
    }
    .label {
      font-size: 1rem;
    }
    .arr {
      transform: rotate(90deg);
      align-self: center;
      font-size: 1.1rem;
    }
  }
</style>
