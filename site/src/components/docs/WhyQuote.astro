---
/**
 * Page-specific (why-imprnt): a pull-quote for the one line the page turns on.
 * The same filled tinted surface and radius as the page's other cards, body
 * size, no left-border bar (that reads as a callout tell). Pass the line as the
 * default slot. Scoped CSS, theme-aware.
 */
---

<blockquote class="pull">
  <slot />
</blockquote>

<style>
  .pull {
    margin: 1.4rem 0;
    padding: 1rem 1.1rem;
    border: none;
    border-radius: 13px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 10%, var(--sl-color-bg));
    font-size: 0.95rem;
    line-height: 1.55;
    font-weight: 400;
    color: var(--sl-color-white);
  }
  .pull :global(p) {
    margin: 0;
  }
  .pull :global(strong) {
    color: var(--sl-color-white);
    font-weight: 700;
  }
</style>
