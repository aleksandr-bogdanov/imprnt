---
/**
 * comparison.mdx ONLY - the field, tool by tool. A real 5-column table on
 * desktop (zebra rows, sticky header, the imprnt row tinted green) that
 * collapses to one card per tool below 880px so all five fields survive on a
 * phone. Every cell's full text is data and is kept verbatim, traced to
 * docs/competitors/ (checked 2026-06-20, freshness re-checked 2026-07-02;
 * Hermes Agent and OpenClaw rows added 2026-08-26).
 * Scoped CSS only, no Tailwind (docs pages do not load it), theme-aware via
 * --sl tokens.
 */
const COLS = ["Tool", "Where memory lives", "Retrieval", "Capture", "AI reads via"];

// `chips` flags substrings to render as nowrap code chips so they stop
// breaking across lines inside a narrow cell. Full text is preserved.
const ROWS = [
  {
    tool: "imprnt",
    self: true,
    where: "Plain Markdown files you own",
    retrieval: "BM25 + grep, no model in loop",
    capture: "Conscious, on demand",
    reads: "Greps the files directly, no server",
  },
  {
    tool: "Karpathy's LLM Wiki",
    note: "pattern, with impls like obsidian-wiki, llmwiki",
    where: "Plain Markdown: immutable raw/ plus an LLM-compiled wiki/",
    retrieval: "Index-first: the LLM reads index.md, then full pages. No embeddings",
    capture: "Conscious: drop a source, tell the LLM to compile it",
    reads: "Agent reads files directly, no server (optional qmd search)",
  },
  {
    tool: "Basic Memory",
    where: "Markdown files plus a derived SQLite index",
    retrieval: "Hybrid: SQLite full-text plus vectors (default), full-text fallback",
    capture: "Conscious write_note",
    reads: "MCP server",
  },
  {
    tool: "Obsidian",
    note: "base app, plain files, no DB pivot",
    where: "Plain Markdown files you own",
    retrieval: "Human-driven: links, tags, search, graph, Dataview/Bases. No AI by default",
    capture: "Conscious: you write notes and links by hand",
    reads: "Its own GUI app. AI only via a plugin that adds a vector store",
  },
  {
    tool: "Logseq",
    note: "DB version is now the main product (2.0 beta), file version is maintenance-mode Logseq OG",
    where: "Plain Markdown/org files (Logseq OG). The DB version, now the main line, makes a local SQLite store canonical, Markdown an export",
    retrieval: "Human-driven: block refs, links, Datalog queries, graph. No AI by default",
    capture: "Conscious: you outline blocks and links as you write",
    reads: "Its own app and query engine. AI only via a sidecar plugin",
  },
  {
    tool: "Reor",
    note: "archived March 2026 (dormant since 2025)",
    where: "Markdown files plus LanceDB vectors",
    retrieval: "Embeddings, vector similarity",
    capture: "Auto-embed on every write",
    reads: "Built-in desktop app, no MCP",
  },
  {
    tool: "Khoj",
    note: "self-host only, cloud closed 2026",
    where: "Its own Postgres plus pgvector DB",
    retrieval: "Embeddings plus neural re-rank",
    capture: "Sync and index your docs",
    reads: "Its own app: query embedded, recalled, reranked, fed to the chat LLM",
  },
  {
    tool: "mem0",
    where: "Managed multi-store: vector (~20 backends) plus optional graph",
    retrieval: "Hybrid: semantic plus BM25 plus entity matching, fused",
    capture: "Auto-extract from turns",
    reads: "API or MCP server (OpenMemory retired Aug 2026)",
  },
  {
    tool: "Letta / MemGPT",
    note: "agent-state runtime turned personal agent",
    where: "MemFS: git-backed Markdown tree (legacy server path: Postgres plus pgvector)",
    retrieval: "Agent greps and reads its own files, model in the read loop",
    capture: "Agent self-edits plus /remember plus background dreaming subagents",
    reads: "Terminal agent, desktop app, channels (Telegram, Slack, Discord...), or API",
  },
  {
    tool: "Zep / Graphiti",
    where: "Temporal knowledge graph (Neo4j default)",
    retrieval: "Hybrid: embeddings plus BM25 plus graph",
    capture: "Auto-extract into the graph",
    reads: "SaaS (Zep) or MCP (Graphiti)",
  },
  {
    tool: "cognee",
    where: "Graph plus vectors plus relational",
    retrieval: "Hybrid, with a model on the read path",
    capture: "Auto-extract from many formats",
    reads: "Library or MCP",
  },
  {
    tool: "mempalace",
    where: "Vector DB (ChromaDB default)",
    retrieval: "Embeddings plus boosting plus optional LLM re-rank",
    capture: "Manual and auto hooks",
    reads: "MCP server (35 tools)",
  },
  {
    tool: "Supermemory",
    where: "Cloud store, with a real self-host mode",
    retrieval: "Embeddings",
    capture: "Auto-capture",
    reads: "API, MCP, or local binary",
  },
  {
    tool: "iai",
    where: 'Encrypted SQLite ("Hippo", own Rust engine, AES-256), 3 tiers',
    retrieval: "Local embeddings (bge-small) plus graph links plus recency, with a BM25 lexical lane fused in, no LLM in the hot path",
    capture: "Automatic, via hooks (Claude Code, Codex, Cursor, and more)",
    reads: "MCP server",
  },
  {
    tool: "ECC",
    note: "config pack for coding agents - memory is one subsystem",
    where: "Markdown session summaries plus YAML/JSONL habit files under the home dir, plus a SQLite state store",
    retrieval: "None. Newest session summary injected at session start (7-day window, 30-day retention)",
    capture: "Automatic hooks on every session, plus a background model distilling habits",
    reads: "Harness injection at session start. Mid-session needs explicit commands",
  },
  {
    tool: "Hermes Agent",
    note: "personal agent, memory is a built-in feature",
    where: "Two capped Markdown files (~3.5KB total) plus SQLite session history",
    retrieval: "FTS5 full-text over raw session messages, no vectors documented",
    capture: "Agent self-curates on periodic nudges, approval gate off by default",
    reads: "Capped files injected whole at session start, session_search for history",
  },
  {
    tool: "OpenClaw",
    note: "personal assistant runtime, foundation-stewarded",
    where: "Plain Markdown workspace plus a derived SQLite index",
    retrieval: "Hybrid vector plus keyword in SQLite, OpenAI embeddings by default",
    capture: "Agent-written: dailies, silent pre-compaction flush, dream sweeps",
    reads: "Local gateway agent, memory_search tool, core files always in context",
  },
  {
    tool: "nanobot",
    note: "HKUDS personal agent, 47k stars in seven months",
    where: "Plain Markdown workspace (MEMORY.md, USER.md, SOUL.md) plus append-only history.jsonl, git-versioned",
    retrieval: "None: MEMORY.md injected whole every turn, agent greps history on demand, no index or vectors",
    capture: "Automatic: consolidator summarizes turns, a Dream pass edits the files every 2h by default",
    reads: "System-prompt injection plus its own grep and file tools",
  },
  {
    tool: "CowAgent",
    note: "formerly chatgpt-on-wechat, China-first agent harness",
    where: "Plain Markdown workspace (~/cow) plus a derived SQLite index",
    retrieval: "Hybrid: 0.7 vector plus 0.3 FTS5 BM25, OpenAI embeddings by default, keyword-only without a key",
    capture: "Agent-written dailies plus a nightly Deep Dream pass that rewrites MEMORY.md",
    reads: "Local harness agent over 12 channels, memory_search / memory_get tools",
  },
  {
    tool: "QwenPaw",
    note: "Alibaba's personal agent, CoPaw rebranded Apr 2026",
    where: "Agent-written Markdown with frontmatter and wikilinks (ReMe workspace) plus verbatim session history",
    retrieval: "BM25 plus bounded wikilink expansion by default, embeddings off by default, optional RRF fusion and rerank",
    capture: "Automatic: conversations continuously digested, dream-cron consolidation",
    reads: "Assistant runtime via ReMe search (CLI/MCP/HTTP), chunks with line ranges plus linked neighbors",
  },
  {
    tool: "ZeroClaw",
    note: "Rust personal-agent runtime, 32.7k stars in six months",
    where: "SQLite brain.db in the agent workspace (flat Markdown backend optional)",
    retrieval: "FTS5 BM25 keyword-only by default, embeddings and hybrid opt-in",
    capture: "Ambient: auto-saves what you tell it, plus explicit memory_store",
    reads: "Runtime injects a [Memory context] block, memory_recall tool mid-turn",
  },
  {
    tool: "NanoClaw",
    note: "personal agent runtime, the security-first OpenClaw answer",
    where: "Plain Markdown (OKF) per agent group, no DB, no embeddings",
    retrieval: "Agent-driven rg/find plus hand-kept index links, model in the loop",
    capture: "Agent self-writes mid-session, steered by an editable definition file",
    reads: "index.md injected at context start (16k cap), files read in-container",
  },
  {
    tool: "IronClaw",
    note: "NEAR AI's Rust reimplementation of the OpenClaw idea",
    where: "Rows in an embedded DB (libSQL, Postgres served) shaped as a virtual path workspace",
    retrieval: "Deterministic FTS5 plus optional vector, RRF-fused, agent-invoked",
    capture: "Agent-written unprompted, with editorial policy plus a background curation pass",
    reads: "Gateway agent over REPL, webhooks, WASM channels, memory tools mid-turn",
  },
];
---

<div class="ct">
  {/* desktop: a real table, sticky header + zebra + tinted imprnt row */}
  <div class="ct-scroll" role="region" aria-label="The field, tool by tool" tabindex="0">
    <table class="ct-table">
      <thead>
        <tr>{COLS.map((c) => <th>{c}</th>)}</tr>
      </thead>
      <tbody>
        {
          ROWS.map((r) => (
            <tr class={r.self ? "self" : ""}>
              <th scope="row" class="ct-tool">
                <span class="ct-toolname">{r.tool}</span>
                {r.note && <span class="ct-note">{r.note}</span>}
              </th>
              <td>{r.where}</td>
              <td>{r.retrieval}</td>
              <td>{r.capture}</td>
              <td>{r.reads}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {/* mobile: one card per tool so all five fields survive */}
  <div class="ct-cards">
    {
      ROWS.map((r) => (
        <div class={r.self ? "ct-card self" : "ct-card"}>
          <div class="ct-card-head">
            <span class="ct-toolname">{r.tool}</span>
            {r.note && <span class="ct-note">{r.note}</span>}
          </div>
          <dl>
            <dt>where memory lives</dt>
            <dd>{r.where}</dd>
            <dt>retrieval</dt>
            <dd>{r.retrieval}</dd>
            <dt>capture</dt>
            <dd>{r.capture}</dd>
            <dt>AI reads via</dt>
            <dd>{r.reads}</dd>
          </dl>
        </div>
      ))
    }
  </div>
</div>

<style>
  .ct {
    margin: 1.4rem 0;
  }

  /* ---- desktop table ---- */
  .ct-scroll {
    position: relative;
    overflow-x: auto;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 7%, var(--sl-color-bg));
  }
  .ct-table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .ct-table thead th {
    text-align: left;
    font-family: var(--sl-font);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-white);
    background: color-mix(in oklab, var(--sl-color-gray-3) 24%, var(--sl-color-bg));
    padding: 0.7rem 0.9rem;
    white-space: nowrap;
    box-shadow: inset 0 -1px 0 var(--sl-color-hairline-shade);
  }
  .ct-table tbody td,
  .ct-table tbody th {
    padding: 0.7rem 0.9rem;
    vertical-align: top;
    color: var(--sl-color-gray-1);
    min-width: 8.5rem;
    border: 0;
  }
  .ct-table tbody tr:nth-child(even) {
    background: color-mix(in oklab, var(--sl-color-gray-3) 9%, var(--sl-color-bg));
  }
  .ct-table tbody tr.self,
  .ct-card.self {
    background: color-mix(in oklab, var(--sl-color-text-accent) 13%, var(--sl-color-bg));
  }
  .ct-tool {
    min-width: 11rem;
  }
  .ct-toolname {
    display: block;
    font-family: var(--sl-font);
    font-weight: 700;
    color: var(--sl-color-white);
  }
  tr.self .ct-toolname,
  .ct-card.self .ct-toolname {
    color: var(--sl-color-white);
  }
  .ct-note {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    font-style: italic;
    color: var(--sl-color-gray-3);
  }

  /* code-shaped tokens inside cells stay on one line */
  .ct-table td,
  .ct-card dd {
    overflow-wrap: break-word;
  }

  .ct-cards {
    display: none;
  }

  /* ---- mobile cards (all five fields survive) ---- */
  @media (max-width: 880px) {
    .ct-scroll {
      display: none;
    }
    .ct-cards {
      display: grid;
      gap: 0.8rem;
    }
    .ct-card {
      border-radius: 12px;
      padding: 0.85rem 1rem 0.95rem;
      background: color-mix(in oklab, var(--sl-color-gray-3) 9%, var(--sl-color-bg));
    }
    .ct-card-head {
      margin-bottom: 0.6rem;
    }
    .ct-card .ct-toolname {
      font-size: 1.02rem;
    }
    .ct-card dl {
      display: grid;
      grid-template-columns: 8.5rem 1fr;
      gap: 0.35rem 0.7rem;
      margin: 0;
    }
    .ct-card dt {
      font-family: var(--sl-font);
      font-size: 0.66rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--sl-color-gray-2);
      padding-top: 0.12rem;
    }
    .ct-card dd {
      margin: 0;
      font-size: 0.86rem;
      line-height: 1.4;
      color: var(--sl-color-gray-1);
    }
    .ct-card.self dd {
      color: var(--sl-color-white);
    }
  }
  @media (max-width: 460px) {
    .ct-card dl {
      grid-template-columns: 1fr;
      gap: 0.05rem 0;
    }
    .ct-card dd {
      margin: 0 0 0.5rem;
    }
    .ct-card dd:last-child {
      margin-bottom: 0;
    }
  }
</style>
