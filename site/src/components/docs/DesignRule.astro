---
/**
 * Page-specific (design-decisions). The headline rule of a section, promoted
 * from a muted Starlight blockquote into a filled accent surface so the page's
 * single most important call reads as strongly as the nav cards and flip badges
 * around it. A mono label (the one rule / the test) plus the rule as the body.
 * The <slot> carries the prose so it can hold inline code. Borderless tinted
 * surface, same radius and tint family as the other cards. Scoped CSS, no Tailwind.
 */
interface Props {
  label?: string;
}
const { label = "the one rule" } = Astro.props;
---

<div class="dd-rule">
  <span class="dd-rule-label">{label}</span>
  <p class="dd-rule-body"><slot /></p>
</div>

<style>
  .dd-rule {
    margin: 1.3rem 0;
    padding: 1.1rem 1.3rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 14%, var(--sl-color-bg));
  }
  .dd-rule-label {
    display: block;
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
    margin-bottom: 0.45rem;
  }
  .dd-rule-body {
    margin: 0;
    font-family: var(--sl-font);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--sl-color-white);
  }
  .dd-rule-body :global(code) {
    font-size: 0.88em;
  }
  @media (max-width: 640px) {
    .dd-rule-body {
      font-size: 1.05rem;
    }
  }
</style>
