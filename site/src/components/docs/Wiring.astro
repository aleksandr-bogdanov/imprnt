---
/**
 * How a plugin wires into Claude: the same agent.md fragment loads either for one
 * project (via CLAUDE.local.md) or for every session (via the user CLAUDE.md).
 * Two filled lanes, no borders. Scoped CSS, theme-aware via Starlight tokens.
 */
const LANES = [
  {
    scope: "global",
    file: "imp",
    dest: "every imp session",
    accent: true,
  },
  {
    scope: "project",
    file: "CLAUDE.local.md",
    dest: "this project's sessions",
    accent: false,
  },
];
---

<div class="wiring">
  {
    LANES.map((l) => (
      <div class={`lane${l.accent ? " accent" : ""}`}>
        <span class="tag">{l.scope}</span>
        <div class="flow">
          <span class="chip">agent.md</span>
          <span class="arr" aria-hidden="true">&rarr;</span>
          <span class="chip">{l.file}</span>
          <span class="arr" aria-hidden="true">&rarr;</span>
          <span class="dest">{l.dest}</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  .wiring {
    display: grid;
    gap: 0.6rem;
    margin: 1.4rem 0;
  }
  .lane {
    border-radius: 13px;
    padding: 0.85rem 1.05rem;
    background: color-mix(in oklab, var(--sl-color-gray-3) 12%, var(--sl-color-bg));
  }
  .lane.accent {
    background: color-mix(in oklab, var(--sl-color-text-accent) 10%, var(--sl-color-bg));
  }
  .tag {
    display: inline-block;
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.55rem;
    color: var(--sl-color-gray-2);
  }
  .lane.accent .tag {
    color: var(--sl-color-text-accent);
  }
  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.6rem;
  }
  .chip {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    padding: 0.22rem 0.55rem;
    border-radius: 7px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 20%, var(--sl-color-bg));
    color: var(--sl-color-gray-1);
  }
  .lane.accent .chip {
    background: color-mix(in oklab, var(--sl-color-text-accent) 18%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .arr {
    color: var(--sl-color-gray-4);
    font-size: 0.9rem;
  }
  .dest {
    font-size: 0.88rem;
    color: var(--sl-color-white);
    font-weight: 600;
  }
</style>
