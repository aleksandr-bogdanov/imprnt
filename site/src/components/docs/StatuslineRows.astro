---
/**
 * Page-specific (statusline): decodes the four panel rows. One table row per
 * panel line, columns Row / What it shows. The "what it shows" column names the
 * segment CATEGORIES (so adding or dropping a segment never touches this). The
 * verbatim example values are NOT repeated here, the dark panel directly above
 * is the canonical source for every value, so this table stays a pure legend.
 * No borders, theme-aware tokens, alternating filled surfaces.
 */
const ROWS = [
  {
    name: "model",
    shows: "Which model is running, the session name, the working dir, and git ahead/behind.",
  },
  {
    name: "cost",
    shows: "Spend so far, elapsed time, and lines added/removed this session.",
  },
  {
    name: "ctx",
    shows: "A gauge of how full the context window is, the fill percent, and the effort level.",
  },
  {
    name: "limits",
    shows: "The 5h and 7d rate-limit windows with reset times, your vault note and review counts, the weather, and the clock.",
  },
];
---

<div class="sl-decode">
  <table>
    <thead>
      <tr><th>Row</th><th>What it shows</th></tr>
    </thead>
    <tbody>
      {
        ROWS.map((r) => (
          <tr>
            <td><span class="sl-rowname">{r.name}</span></td>
            <td>{r.shows}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .sl-decode {
    margin: 1.4rem 0;
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  thead th {
    text-align: left;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    padding: 0 0.75rem 0.5rem;
  }
  th:nth-child(1) {
    width: 7rem;
  }
  tbody td {
    padding: 0.6rem 0.75rem;
    vertical-align: top;
    color: var(--sl-color-gray-1);
    background: color-mix(in oklab, var(--sl-color-gray-3) 7%, var(--sl-color-bg));
  }
  /* Nudge the pill cell so the pill's text baseline sits on the
     description's first line when that description wraps (mobile). */
  tbody td:first-child {
    padding-top: 0.66rem;
  }
  tbody tr:nth-child(even) td {
    background: color-mix(in oklab, var(--sl-color-gray-3) 14%, var(--sl-color-bg));
  }
  .sl-rowname {
    display: inline-block;
    font-family: var(--sl-font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.16rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 20%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
  }
  /* On a phone the 7rem gutter is dead space next to a short pill and forces
     each description into more wrapped lines. Tighten it so the description
     column gains width and wraps to fewer lines on the narrowest screens. */
  @media (max-width: 50rem) {
    th:nth-child(1) {
      width: 4.5rem;
    }
  }
</style>
