---
/**
 * Page-specific (statusline): a tiny legend for the alarm ramp the prose
 * describes. Three filled swatches show the three bands as CATEGORIES (green,
 * amber, red) with the threshold each one starts at, so the reader sees the
 * color behavior without a screenshot. The fixed band colors are the actual
 * ramp the script paints (statusline.ts palette: ok #9ece6a, warn #e0af68,
 * bad #f7768e), not theme tokens. All three fills are light enough to carry
 * the same dark text. No borders, filled pills only.
 */
const BANDS = [
  { name: "green", range: "0 to 60%", swatch: "#9ece6a", text: "#11131a" },
  { name: "amber", range: "past 60%", swatch: "#e0af68", text: "#11131a" },
  { name: "red", range: "past 85%", swatch: "#f7768e", text: "#11131a" },
];
---

<div class="sl-ramp">
  {
    BANDS.map((b) => (
      <span class={`sl-band sl-band-${b.name}`} style={`background:${b.swatch};color:${b.text}`}>
        <span class="sl-band-name">{b.name}</span>
        <span class="sl-band-range">{b.range}</span>
      </span>
    ))
  }
</div>

<style>
  .sl-ramp {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.2rem 0;
  }
  .sl-band {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    font-family: var(--sl-font);
    font-size: 0.78rem;
  }
  .sl-band-name {
    font-weight: 700;
  }
  .sl-band-range {
    opacity: 0.85;
    font-size: 0.72rem;
  }
</style>
