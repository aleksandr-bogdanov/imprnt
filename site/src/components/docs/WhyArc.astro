---
/**
 * Page-specific (why-imprnt): the origin story as a scannable spine. Each step
 * is one beat of the path from "the assistant forgot everything" to imprnt. The
 * last step is the payoff and reads in the accent color. Categories of the story,
 * not a hand-maintained instance list. Filled surfaces, a thin rail, no border
 * boxes. Scoped CSS, theme-aware via Starlight tokens, no Tailwind.
 */
const STEPS = [
  { label: "The bike", gist: "I spend two weeks buying a bike for a fifteen-minute commute." },
  { label: "It started with Claude", gist: "Every new chat I briefed a brilliant stranger from zero." },
  { label: "PAI, for someone else", gist: "PAI remembered me, then became more machine than my life needed." },
  { label: "The token bill", gist: "I had become afraid of my own assistant." },
  { label: "The rule", gist: "A machine able to launch spaceships ended up reading spam letters." },
  { label: "The bible", gist: "Eight rules, so the model thinks once and searching is free." },
  { label: "Memory is plain text", gist: "Open any note, fix one line, and take the folder anywhere." },
  { label: "My promise to you", gist: "What you don't need, it doesn't keep, and everything's opt-in.", payoff: true },
];
---

<ol class="arc" aria-label="The path from a forgetful assistant to imprnt">
  {
    STEPS.map((s, i) => (
      <li class={`step${s.payoff ? " payoff" : ""}`}>
        <span class="dot" aria-hidden="true">{i + 1}</span>
        <div class="body">
          <span class="label">{s.label}</span>
          <span class="gist">{s.gist}</span>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .arc {
    list-style: none;
    margin: 1.6rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: 0.55rem 0;
    position: relative;
  }
  /* The rail: a thin filled line behind the dots, drawn per-step so it stops at
     the last dot instead of overshooting. */
  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 0.92rem;
    top: 2rem;
    bottom: -0.35rem;
    width: 2px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 35%, var(--sl-color-bg));
  }
  .dot {
    z-index: 1;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--sl-font);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
    background: color-mix(in oklab, var(--sl-color-gray-3) 22%, var(--sl-color-bg));
  }
  .payoff .dot {
    color: var(--sl-color-text-accent);
    background: color-mix(in oklab, var(--sl-color-text-accent) 18%, var(--sl-color-bg));
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.18rem;
  }
  .label {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--sl-color-white);
  }
  .payoff .label {
    color: var(--sl-color-white);
  }
  .gist {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--sl-color-gray-2);
  }
</style>
