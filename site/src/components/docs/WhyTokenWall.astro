---
/**
 * Page-specific (why-imprnt): the two numbers that turned a context problem into
 * a cost problem. Big figure in accent, small caption under. Filled surfaces, no
 * border boxes. Scoped CSS, theme-aware via Starlight tokens, no Tailwind.
 */
const STATS = [
  { figure: "30k", unit: "tokens", caption: "gone on the first load, before any real work" },
  { figure: "250k", unit: "window", caption: "then it compacts and starts forgetting" },
];
---

<div class="wall">
  {
    STATS.map((s) => (
      <div class="stat">
        <span class="figure">{s.figure}<span class="unit">{s.unit}</span></span>
        <span class="caption">{s.caption}</span>
      </div>
    ))
  }
</div>

<style>
  .wall {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin: 1.4rem 0;
  }
  .stat {
    border-radius: 13px;
    padding: 1.05rem 1.1rem;
    background: color-mix(in oklab, var(--sl-color-text-accent) 9%, var(--sl-color-bg));
    margin-top: 0;
  }
  .figure {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--sl-font-mono);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--sl-color-text-accent);
  }
  .unit {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .caption {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--sl-color-gray-1);
  }
  @media (max-width: 640px) {
    .wall {
      grid-template-columns: 1fr;
    }
    .caption {
      margin-top: 0.75rem;
    }
  }
</style>
