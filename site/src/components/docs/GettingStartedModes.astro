---
/**
 * Page-specific (getting-started) visual: the two ways imp opens Claude, side by
 * side so the either/or is scannable. Two filled cards, no borders. The data (the
 * key difference: current folder vs the vault) stays in full.
 * Scoped CSS, theme-aware via Starlight tokens.
 */
const MODES = [
  {
    cmd: "imp",
    where: "where you stand",
    lines: [
      "Opens in your current folder.",
      "Your plugins and your vault stay in reach.",
      "A coding session can answer \"who owns this service?\" from your own notes.",
    ],
    accent: true,
  },
  {
    cmd: "imp lair",
    where: "inside the vault",
    lines: [
      "Opens inside the vault itself.",
      "The full contract loads here.",
      "Your personal chats pile up in one place you can resume.",
    ],
    accent: false,
  },
];
---

<div class="gsmodes">
  {
    MODES.map((m) => (
      <div class={`mode${m.accent ? " accent" : ""}`}>
        <div class="head">
          <code class="cmd">{m.cmd}</code>
          <span class="where">{m.where}</span>
        </div>
        <ul class="lines">
          {m.lines.map((l) => <li>{l}</li>)}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .gsmodes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
    gap: 0.7rem;
    margin: 1.3rem 0;
  }
  .mode {
    border-radius: 13px;
    padding: 0.95rem 1.05rem 0.9rem;
    background: color-mix(in oklab, var(--sl-color-gray-3) 12%, var(--sl-color-bg));
    /* Starlight's prose rhythm adds a 16px top margin to any element that
       follows a sibling, which shoved the second card (and all its content)
       16px lower than the first. Reset it so both grid cards top-align. */
    margin-top: 0;
  }
  .mode.accent {
    background: color-mix(in oklab, var(--sl-color-text-accent) 10%, var(--sl-color-bg));
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  /* Scope to .gsmodes so the explicit grey chip beats Starlight's global
     :not(pre)>code styling (the pale green tint + faint border it leaks onto a
     bare <code>). Without this the non-accent "imp lair" command reads green and
     muddies the one-card-is-highlighted signal. Green only on the accent card. */
  .gsmodes .cmd {
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-gray-1);
    background: color-mix(in oklab, var(--sl-color-gray-3) 24%, var(--sl-color-bg));
    padding: 0.22rem 0.6rem;
    border-radius: 7px;
    border: none;
  }
  .gsmodes .mode.accent .cmd {
    color: var(--sl-color-white);
    background: color-mix(in oklab, var(--sl-color-text-accent) 16%, var(--sl-color-bg));
  }
  .where {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .lines li {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--sl-color-white);
    padding-left: 1.1rem;
    position: relative;
  }
  .lines li::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.725em;
    transform: translateY(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sl-color-gray-4);
  }
  .mode.accent .lines li::before {
    background: color-mix(in oklab, var(--sl-color-text-accent) 70%, var(--sl-color-bg));
  }
  @media (max-width: 640px) {
    .gsmodes {
      grid-template-columns: 1fr;
    }
  }
</style>
