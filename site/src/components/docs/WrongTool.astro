---
/**
 * comparison.mdx ONLY - the "is this for me?" answer as a scannable card grid:
 * what you want -> which tool fits when imprnt does not. Borderless filled
 * cards. Scoped CSS only, no Tailwind, theme-aware via --sl tokens.
 */
const CASES = [
  {
    want: "Zero-effort ambient memory",
    pick: "mem0, Zep, mempalace, iai",
    why: "You want the assistant to silently remember every chat with no filing step. imprnt's conscious capture gets in the way. These capture turns automatically.",
  },
  {
    want: "Encrypted automatic memory behind Claude Code",
    pick: "iai",
    why: "It installs hooks, captures every turn, and keeps an encrypted local store. imprnt keeps plain files with no encryption layer, since privacy comes from the directory being yours and owner-only.",
  },
  {
    want: "A product, not a personal vault",
    pick: "mem0, Zep, Supermemory",
    why: "A multi-user app needs a memory API, a hosted service, and per-user isolation. imprnt is single-owner, local, no API surface.",
  },
  {
    want: "An agent that manages its own state at scale",
    pick: "Letta",
    why: "The purest version of an agent that pages and self-edits its own memory across long runs.",
  },
  {
    want: "Semantic recall across messy unlabeled text",
    pick: "any embeddings tool above",
    why: "If your corpus is large, unstructured, and you will not tag it on the way in, embeddings out-recall BM25. imprnt's bet pays off because the write path does the labeling. Skip that work and the bet weakens.",
  },
];
---

<div class="wt">
  {
    CASES.map((c, i) => (
      <div class={i === CASES.length - 1 ? "wt-card wt-wide" : "wt-card"}>
        <p class="wt-want">{c.want}</p>
        <p class="wt-pick">
          <span class="wt-pick-label">pick instead</span>
          {c.pick}
        </p>
        <p class="wt-why">{c.why}</p>
      </div>
    ))
  }
</div>

<style>
  .wt {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    /* three shared row tracks (title, pick, why) so a one-line and a two-line
       title in the same row reserve the same box and the pick-instead badges
       and body baselines line up across the row */
    grid-auto-rows: auto auto 1fr;
    column-gap: 0.8rem;
    row-gap: 0.8rem;
    margin: 1.4rem 0;
  }
  /* the lone fifth card sits in the first column, left-aligned under the column
     above it, so the trailing gap reads as deliberate, not a stray center. */
  .wt-wide {
    grid-column: 1;
  }
  @media (max-width: 720px) {
    .wt {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .wt-wide {
      grid-column: auto;
    }
  }
  .wt-card {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0.55rem;
    align-content: start;
    border-radius: 14px;
    padding: 1rem 1.15rem 1.05rem;
    background: color-mix(in oklab, var(--sl-color-orange) 9%, var(--sl-color-bg));
  }
  .wt-want {
    margin: 0;
    font-family: var(--sl-font);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .wt-pick {
    margin: 0;
    font-size: 0.92rem;
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .wt-pick-label {
    display: inline-block;
    margin-right: 0.5rem;
    padding: 0.12em 0.42em;
    border-radius: 5px;
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--sl-color-orange-high);
    background: color-mix(in oklab, var(--sl-color-orange) 20%, var(--sl-color-bg));
    vertical-align: 0.1em;
  }
  .wt-why {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--sl-color-gray-1);
  }
</style>
