---
/**
 * Page-specific (how-it-works): the eval result as a scannable stat block.
 * Two numbers surfaced from prose, the run-it-yourself command kept verbatim.
 * Filled surface, no borders. Scoped CSS, theme-aware via Starlight tokens.
 */
---

<div class="eval">
  <div class="stats">
    <span class="num">9 in 10</span>
    <span class="num">~97%</span>
    <span class="cap">right note ranked first</span>
    <span class="cap">in the top five the assistant reads</span>
  </div>
  <p class="foot">
    Measured across the two example vaults and 39 everyday questions. A small test, and the number will move. Run <code>bun run eval</code> to check it yourself.
  </p>
</div>

<style>
  .eval {
    margin: 1.5rem 0;
    padding: 1.2rem 1.25rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 10%, var(--sl-color-bg));
  }
  .stats {
    /* both numbers live in row 1, both captions in row 2, so the two .num share
       one top edge no matter their width. each column is only as wide as its
       caption (the widest cell), so the two stats sit as a tight balanced pair
       instead of drifting to the block edges, capped so a caption still wraps. */
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 14rem));
    grid-template-rows: auto auto;
    justify-content: start;
    align-items: end;
    column-gap: 2.4rem;
    row-gap: 0.4rem;
  }
  .num {
    grid-row: 1;
    align-self: start;
    margin: 0;
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1;
    color: var(--sl-color-text-accent);
  }
  .cap {
    grid-row: 2;
    font-size: 0.85rem;
    line-height: 1.3;
    color: var(--sl-color-gray-1);
  }
  .foot {
    margin: 0.95rem 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--sl-color-gray-1);
  }
  .foot code {
    font-family: var(--sl-font-mono);
    font-size: 0.82rem;
    white-space: nowrap;
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 25%, var(--sl-color-bg));
  }
  @media (max-width: 640px) {
    .stats {
      /* stack each number directly above its own caption on a narrow screen */
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, auto);
      column-gap: 0;
      row-gap: 0.15rem;
    }
    /* re-order the flat list (num, num, cap, cap) into num1, cap1, num2, cap2 */
    .stats > :nth-child(1) {
      grid-row: 1;
    }
    .stats > :nth-child(3) {
      grid-row: 2;
    }
    .stats > :nth-child(2) {
      grid-row: 3;
      margin-top: 0.85rem;
    }
    .stats > :nth-child(4) {
      grid-row: 4;
    }
  }
</style>
