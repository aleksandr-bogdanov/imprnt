---
/**
 * The only two places the core touches a plugin, both found by filename, never
 * by import. Borderless filled rows: command, the file it reads, what it does.
 */
const BRIDGES = [
  {
    cmd: "imprnt check --all",
    reads: "plugins/*/check.js",
    note: "runs each, reads the exit code only",
  },
  {
    cmd: "imprnt ingest --apply",
    reads: "plugins/*/proposed/",
    note: "files the notes a plugin staged for you",
  },
];
---

<div class="bridges">
  {
    BRIDGES.map((b) => (
      <div class="bridge">
        <div class="lane">
          <code class="cmd">{b.cmd}</code>
          <span class="arrow" aria-hidden="true">
            <svg viewBox="0 0 40 8" preserveAspectRatio="none">
              <line x1="0" y1="4" x2="34" y2="4" />
              <path d="M30 1 L36 4 L30 7" fill="none" />
            </svg>
          </span>
          <code class="reads">{b.reads}</code>
        </div>
        <span class="note">{b.note}</span>
      </div>
    ))
  }
</div>

<style>
  .bridges {
    display: grid;
    gap: 0.6rem;
    margin: 1.4rem 0;
  }
  .bridge {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 0.85rem 1.05rem;
    border-radius: 12px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 7%, var(--sl-color-bg));
  }
  .lane {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .bridge .cmd {
    font-family: var(--sl-font-mono);
    font-size: 0.82rem;
    color: var(--sl-color-text-accent);
    background: none;
    padding: 0;
    font-weight: 600;
  }
  .bridge .arrow {
    display: inline-flex;
    width: 2.4rem;
    color: var(--sl-color-gray-4);
  }
  .bridge .arrow svg {
    width: 100%;
    height: 0.55rem;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .bridge .reads {
    font-family: var(--sl-font-mono);
    font-size: 0.82rem;
    color: var(--sl-color-gray-1);
    background: none;
    padding: 0;
  }
  .bridge .note {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
  @media (max-width: 640px) {
    .bridge .note {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>
