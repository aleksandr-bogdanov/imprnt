---
/**
 * fleet page ONLY - the reconcile shape. One registry as desired state on the
 * left, three projections converged to it, and the foreign-state strip below:
 * reported, never adopted, never destroyed. Filled surfaces, no borders,
 * scoped CSS, theme-aware via Starlight tokens (docs pages load no Tailwind).
 * Reveal animation is added by script only when motion is allowed, so no-JS
 * and reduced-motion visitors get the static diagram.
 */
---

<div
  class="frflow"
  role="img"
  aria-label="One registry file holds the desired state of the fleet: each agent's name, working directory, model, and status. A reconcile loop converges three projections to it: service units, terminal sessions, and chat channels. The loop is level-based: every pass reads actual state and fixes the difference, so a missed event can never leave permanent drift. Anything that exists without a registry entry, a hand-made channel or an unregistered session, is foreign state: reported once, never adopted, never destroyed."
>
  <div class="fr-row">
    <div class="fr-node fr-registry" style="--i: 0">
      <span class="fr-tag accent">the registry</span>
      <span class="fr-sub">one JSON file: each agent's name, directory, model, status</span>
      <span class="fr-fine">desired state. The only thing a human edits</span>
    </div>

    <div class="fr-conv" style="--i: 0.5" aria-hidden="true">
      <span class="fr-conv-label">reconcile</span>
      <span class="fr-arr">&rarr;</span>
      <span class="fr-conv-fine">every pass reads actual state, fixes the difference</span>
    </div>

    <div class="fr-projs">
      <div class="fr-node" style="--i: 1">
        <span class="fr-tag">service units</span>
        <span class="fr-sub">enabled for every entry, so agents survive a reboot</span>
      </div>
      <div class="fr-node" style="--i: 1.4">
        <span class="fr-tag">sessions</span>
        <span class="fr-sub">a live process for every entry, restarted with backoff</span>
      </div>
      <div class="fr-node" style="--i: 1.8">
        <span class="fr-tag">chat channels</span>
        <span class="fr-sub">one per entry, archived when the entry goes, reclaimed when it returns</span>
      </div>
    </div>
  </div>

  <div class="fr-foreign" style="--i: 2.4">
    <span class="fr-tag">foreign state</span>
    <span class="fr-sub">a hand-made channel, a session nobody registered</span>
    <span class="fr-chip">reported once</span>
    <span class="fr-chip">never adopted</span>
    <span class="fr-chip">never destroyed</span>
  </div>
</div>

<style>
  .frflow {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 1.5rem 0 1.4rem;
  }
  .fr-row {
    display: flex;
    align-items: stretch;
    gap: 0.35rem;
  }
  .fr-node {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.85rem 0.9rem 0.9rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 12%, var(--sl-color-bg));
  }
  .fr-registry {
    flex: 0 1 16rem;
    background: color-mix(in oklab, var(--sl-color-text-accent) 12%, var(--sl-color-bg));
  }
  .fr-projs {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .fr-conv {
    align-self: center;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0 0.35rem;
    max-width: 8.5rem;
    text-align: center;
  }
  .fr-conv-label {
    font-family: var(--sl-font);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
  }
  .fr-arr {
    color: var(--sl-color-gray-1);
    font-size: 1.2rem;
    line-height: 1;
  }
  .fr-conv-fine {
    font-size: 0.66rem;
    line-height: 1.35;
    color: var(--sl-color-gray-2);
  }
  .fr-tag {
    font-family: var(--sl-font);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .fr-tag.accent {
    color: var(--sl-color-text-accent);
  }
  .fr-sub {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--sl-color-gray-1);
  }
  .fr-fine {
    font-size: 0.7rem;
    line-height: 1.35;
    color: var(--sl-color-gray-2);
  }
  .fr-foreign {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    padding: 0.7rem 0.9rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 12%, var(--sl-color-bg));
  }
  .fr-foreign .fr-sub {
    flex: 1 1 12rem;
  }
  .fr-chip {
    font-size: 0.74rem;
    line-height: 1.3;
    padding: 0.18rem 0.5rem;
    border-radius: 8px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 26%, var(--sl-color-bg));
    color: var(--sl-color-gray-1);
  }

  /* Reveal states, applied only when the script adds .anim (motion allowed). */
  .frflow.anim :is(.fr-node, .fr-conv, .fr-foreign) {
    opacity: 0;
    transform: translateY(8px);
  }
  .frflow.anim.on :is(.fr-node, .fr-conv, .fr-foreign) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: calc(var(--i, 0) * 150ms);
  }

  @media (max-width: 760px) {
    .fr-row {
      flex-direction: column;
      gap: 0.4rem;
    }
    .fr-registry {
      flex: 1 1 auto;
    }
    .fr-conv {
      max-width: none;
      flex-direction: row;
      gap: 0.5rem;
    }
    .fr-arr {
      transform: rotate(90deg);
    }
    .frflow.anim.on .fr-arr {
      transform: rotate(90deg);
    }
  }
</style>

<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const root of document.querySelectorAll(".frflow")) {
      root.classList.add("anim");
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              root.classList.add("on");
              obs.disconnect();
            }
          }
        },
        { threshold: 0.2 },
      );
      io.observe(root);
    }
  }
</script>
