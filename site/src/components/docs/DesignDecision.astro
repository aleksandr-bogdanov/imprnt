---
/**
 * Page-specific (design-decisions). The progressive-disclosure card every
 * decision on the page lives in: a native <details> whose always-visible
 * summary carries a small glyph and the decision stated in one plain line,
 * with the reasoning, the visual, and the flips-if line inside. Native
 * details keeps it accessible and working with zero JS. The script adds
 * three enhancements: a scroll-in reveal (reduced-motion aware), and
 * deep-link handling so a TOC or hash jump to the heading above a card
 * opens that card. Open/close animates via ::details-content where the
 * browser supports it, with an instant toggle everywhere else. Filled
 * surfaces, scoped CSS, theme-aware via Starlight tokens, no Tailwind.
 */
interface Props {
  icon: string;
  oneLiner: string;
}
const { icon, oneLiner } = Astro.props;

// one glyph per decision, drawn as 24x24 stroke paths in the accent color
const GLYPHS: Record<string, string> = {
  gauge:
    '<path d="M5.5 15.5a6.5 6.5 0 1 1 13 0"/><path d="M12 15.5l3.4-3.8"/><path d="M4.5 19h15"/>',
  search:
    '<circle cx="10.5" cy="10.5" r="5.5"/><path d="M14.7 14.7L19.5 19.5"/>',
  table:
    '<rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 10.5h16"/><path d="M10.5 10.5V19"/>',
  folder:
    '<path d="M4 8a2 2 0 0 1 2-2h3.6L12 8.4h6a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/>',
  core:
    '<rect x="8.5" y="8.5" width="7" height="7" rx="1.8"/><circle cx="12" cy="4" r="1.4"/><circle cx="12" cy="20" r="1.4"/><circle cx="4" cy="12" r="1.4"/><circle cx="20" cy="12" r="1.4"/>',
  copy:
    '<rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M15.5 8.5V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7.5a2 2 0 0 0 2 2h2.5"/>',
  terminal:
    '<rect x="3.5" y="5" width="17" height="14" rx="2"/><path d="M7 10l3 2.5L7 15"/><path d="M12.5 15.5H17"/>',
  test:
    '<circle cx="12" cy="12" r="8.5"/><path d="M8.3 12.4l2.5 2.5 4.9-5.4"/>',
  lock:
    '<rect x="6" y="10.5" width="12" height="9.5" rx="2"/><path d="M9 10.5V8a3 3 0 0 1 6 0v2.5"/>',
  fork:
    '<circle cx="6.5" cy="5" r="2"/><circle cx="6.5" cy="19" r="2"/><circle cx="17.5" cy="7.5" r="2"/><path d="M6.5 7v10"/><path d="M17.5 9.5a8 8 0 0 1-8 7.5"/>',
  page:
    '<path d="M13.5 4H7.5A1.5 1.5 0 0 0 6 5.5v13A1.5 1.5 0 0 0 7.5 20h9a1.5 1.5 0 0 0 1.5-1.5V8.5z"/><path d="M13.5 4v4.5H18"/>',
};
const glyph = GLYPHS[icon] ?? GLYPHS.page;
---

<details class="ddx" data-ddx>
  <summary class="ddx-sum">
    <span class="ddx-glyph" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={glyph}
      />
    </span>
    <span class="ddx-line">{oneLiner}</span>
    <span class="ddx-hint" aria-hidden="true">
      <svg
        class="ddx-chev"
        viewBox="0 0 16 16"
        width="13"
        height="13"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="M4 6l4 4 4-4"></path></svg
      >
    </span>
  </summary>
  <div class="ddx-body"><slot /></div>
</details>

<style>
  .ddx {
    margin: 0.9rem 0 0.4rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 7%, var(--sl-color-bg));
    interpolate-size: allow-keywords;
  }
  .ddx-sum {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.95rem 1.1rem;
    cursor: pointer;
    list-style: none;
    border-radius: 14px;
    transition: background 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .ddx-sum::-webkit-details-marker {
    display: none;
  }
  .ddx-sum::marker {
    content: "";
  }
  .ddx-sum:hover {
    background: color-mix(in oklab, var(--sl-color-text-accent) 12%, var(--sl-color-bg));
  }
  .ddx-sum:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .ddx-glyph {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 10px;
    color: var(--sl-color-text-accent);
    background: color-mix(in oklab, var(--sl-color-text-accent) 15%, var(--sl-color-bg));
  }
  .ddx-line {
    flex: 1 1 auto;
    font-family: var(--sl-font);
    font-weight: 600;
    font-size: 0.97rem;
    line-height: 1.4;
    color: var(--sl-color-white);
  }
  .ddx-hint {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--sl-font);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .ddx-hint::before {
    content: "why";
  }
  .ddx[open] .ddx-hint::before {
    content: "close";
  }
  .ddx-chev {
    transition: transform 0.25s ease;
  }
  .ddx[open] .ddx-chev {
    transform: rotate(180deg);
  }
  .ddx-body {
    padding: 0.2rem 1.1rem 1.2rem;
  }
  .ddx-body > :global(*:first-child) {
    margin-top: 0.5rem;
  }
  /* the open/close animation, only where ::details-content is supported and
     motion is welcome. Everyone else gets the instant native toggle. */
  @media (prefers-reduced-motion: no-preference) {
    .ddx::details-content {
      opacity: 0;
      block-size: 0;
      overflow-y: clip;
      transition:
        content-visibility 0.32s allow-discrete,
        opacity 0.32s ease,
        block-size 0.32s ease;
    }
    .ddx[open]::details-content {
      opacity: 1;
      block-size: auto;
    }
    /* scroll-in reveal, armed by the script only when motion is allowed */
    .ddx.armed {
      opacity: 0;
      transform: translateY(10px);
    }
    .ddx.in {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.5s ease,
        transform 0.5s ease;
    }
  }
  @media print {
    .ddx::details-content {
      content-visibility: visible;
    }
  }
  @media (max-width: 640px) {
    .ddx-sum {
      gap: 0.65rem;
      padding: 0.85rem 0.9rem;
    }
    .ddx-body {
      padding: 0.2rem 0.9rem 1.1rem;
    }
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLDetailsElement>("details[data-ddx]"));

  // a hash jump (TOC click, shared link) targets the heading above a card,
  // so find the card that follows the target and open it
  const openForHash = () => {
    const id = decodeURIComponent(location.hash.replace("#", ""));
    if (!id) return;
    const target = document.getElementById(id);
    if (!target) return;
    let el: Element | null = target.nextElementSibling;
    while (el && el.tagName !== "DETAILS") {
      if (/^H[1-6]$/.test(el.tagName)) return;
      el = el.nextElementSibling;
    }
    if (el && el.hasAttribute("data-ddx")) (el as HTMLDetailsElement).open = true;
  };
  openForHash();
  window.addEventListener("hashchange", openForHash);

  // scroll-in reveal, matching the site's other docs visuals
  const ddxMotionOk = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
  if (ddxMotionOk && "IntersectionObserver" in window) {
    for (const card of cards) {
      card.classList.add("armed");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              card.classList.add("in");
              io.disconnect();
            }
          }
        },
        { threshold: 0.12 },
      );
      io.observe(card);
    }
  }
</script>
