---
/**
 * Page-specific (design-decisions). The card every decision on the page lives
 * in: a header row with a small glyph and the decision stated in one plain
 * line, then the reasoning, the visual, and the flips-if line, always open.
 * It was a <details> once, which made the reader unfold sixteen cards by hand
 * and, worse, inherited Starlight's 2px left border on details (the accent
 * rail the design bans). A plain filled surface now, no
 * script: a reveal that hides cards until scrolled left a hash jump on a
 * blank page. Scoped CSS, theme-aware via
 * Starlight tokens, no Tailwind.
 */
interface Props {
  icon: string;
  oneLiner: string;
}
const { icon, oneLiner } = Astro.props;

// one glyph per decision, drawn as 24x24 stroke paths in the accent color
const GLYPHS: Record<string, string> = {
  gauge:
    '<path d="M5.5 15.5a6.5 6.5 0 1 1 13 0"/><path d="M12 15.5l3.4-3.8"/><path d="M4.5 19h15"/>',
  search:
    '<circle cx="10.5" cy="10.5" r="5.5"/><path d="M14.7 14.7L19.5 19.5"/>',
  table:
    '<rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 10.5h16"/><path d="M10.5 10.5V19"/>',
  folder:
    '<path d="M4 8a2 2 0 0 1 2-2h3.6L12 8.4h6a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/>',
  core:
    '<rect x="8.5" y="8.5" width="7" height="7" rx="1.8"/><circle cx="12" cy="4" r="1.4"/><circle cx="12" cy="20" r="1.4"/><circle cx="4" cy="12" r="1.4"/><circle cx="20" cy="12" r="1.4"/>',
  copy:
    '<rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M15.5 8.5V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7.5a2 2 0 0 0 2 2h2.5"/>',
  terminal:
    '<rect x="3.5" y="5" width="17" height="14" rx="2"/><path d="M7 10l3 2.5L7 15"/><path d="M12.5 15.5H17"/>',
  test:
    '<circle cx="12" cy="12" r="8.5"/><path d="M8.3 12.4l2.5 2.5 4.9-5.4"/>',
  lock:
    '<rect x="6" y="10.5" width="12" height="9.5" rx="2"/><path d="M9 10.5V8a3 3 0 0 1 6 0v2.5"/>',
  fork:
    '<circle cx="6.5" cy="5" r="2"/><circle cx="6.5" cy="19" r="2"/><circle cx="17.5" cy="7.5" r="2"/><path d="M6.5 7v10"/><path d="M17.5 9.5a8 8 0 0 1-8 7.5"/>',
  page:
    '<path d="M13.5 4H7.5A1.5 1.5 0 0 0 6 5.5v13A1.5 1.5 0 0 0 7.5 20h9a1.5 1.5 0 0 0 1.5-1.5V8.5z"/><path d="M13.5 4v4.5H18"/>',
  model:
    '<rect x="3.5" y="8" width="17" height="8" rx="4"/><circle cx="15.5" cy="12" r="2.4"/>',
  disk:
    '<ellipse cx="12" cy="6.5" rx="7" ry="2.5"/><path d="M5 6.5v11c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-11"/><path d="M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5"/>',
  gate:
    '<path d="M12 3.5l7 2.8v5.2c0 4.3-3 7.6-7 9-4-1.4-7-4.7-7-9V6.3z"/><path d="M9 12l2.2 2.2L15.2 10"/>',
  tenants:
    '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="16.5" cy="9.5" r="2.4"/><path d="M15.5 14.5a4.5 4.5 0 0 1 5 4.5"/>',
  chat:
    '<path d="M4.5 6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H10l-4.5 3.5V15.5h-1a2 2 0 0 1-2-2z"/>',
};
const glyph = GLYPHS[icon] ?? GLYPHS.page;
---

<div class="ddx" data-ddx>
  <div class="ddx-sum">
    <span class="ddx-glyph" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={glyph}
      />
    </span>
    <span class="ddx-line">{oneLiner}</span>
  </div>
  <div class="ddx-body"><slot /></div>
</div>

<style>
  .ddx {
    margin: 0.9rem 0 0.4rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 7%, var(--sl-color-bg));
  }
  .ddx-sum {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.95rem 1.1rem 0.4rem;
  }
  .ddx-glyph {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 10px;
    color: var(--sl-color-text-accent);
    background: color-mix(in oklab, var(--sl-color-text-accent) 15%, var(--sl-color-bg));
  }
  .ddx-line {
    flex: 1 1 auto;
    font-family: var(--sl-font);
    font-weight: 600;
    font-size: 0.97rem;
    line-height: 1.4;
    color: var(--sl-color-white);
  }
  .ddx-body {
    padding: 0.2rem 1.1rem 1.2rem;
  }
  .ddx-body > :global(*:first-child) {
    margin-top: 0.5rem;
  }
  /* the open/close animation, only where ::details-content is supported and
     motion is welcome. Everyone else gets the instant native toggle. */
  @media (max-width: 640px) {
    .ddx-sum {
      gap: 0.65rem;
      padding: 0.85rem 0.9rem;
    }
    .ddx-body {
      padding: 0.2rem 0.9rem 1.1rem;
    }
  }
</style>
