---
/**
 * kleinanzeigen page ONLY - the three jobs as tiles. Each tile carries a mono
 * eyebrow naming where the job looks, a title, the command that runs it, and a
 * plain one-liner. Replaces the old three-bullet list with the same facts.
 * Filled surfaces, no borders, scoped CSS, theme-aware via Starlight tokens
 * (docs pages load no Tailwind).
 */
const JOBS = [
  {
    tag: "your message box",
    cmd: "sync",
    title: "Inbox, both sides",
    body: "Mirrors your sales and your buys. A buyer asking about your router and a seller replying to a part you want land in the same local store, each tagged with which side you are on and whose turn it is.",
  },
  {
    tag: "the marketplace",
    cmd: "watch run",
    title: "Deal-watcher",
    body: "Save a search once. Each run re-fetches the public results page, compares it against the last run, and reports what is new, what fell in price, and what is gone.",
  },
  {
    tag: "before you buy",
    cmd: "detail",
    title: "Seller vetting",
    body: "Before you message a seller, one command pulls their public rating and the ad's details, so you read their standing first.",
  },
];
---

<div class="kjobs">
  {
    JOBS.map((j) => (
      <div class="job">
        <span class="jtag">{j.tag}</span>
        <div class="jhead">
          <span class="jtitle">{j.title}</span>
          <code class="jcmd">{j.cmd}</code>
        </div>
        <p class="jbody">{j.body}</p>
      </div>
    ))
  }
</div>

<style>
  .kjobs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    gap: 0.7rem;
    margin: 1.4rem 0 1.6rem;
  }
  .job {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.05rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-gray-3) 12%, var(--sl-color-bg));
  }
  .jtag {
    font-family: var(--sl-font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .jhead {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .jtitle {
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--sl-color-white);
  }
  .jcmd {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    padding: 0.14rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 16%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
  }
  .jbody {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--sl-color-gray-1);
  }
  @media (max-width: 760px) {
    .kjobs {
      grid-template-columns: 1fr;
    }
  }
</style>
