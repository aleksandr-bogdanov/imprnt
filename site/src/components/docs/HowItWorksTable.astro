---
/**
 * Page-specific (how-it-works): the Step / Who / Why table, with the Who cell
 * rendered as a colored pill so the two actors (model, code) read apart at a
 * glance. All eight rows and all three columns are kept verbatim. This is data,
 * the component only restyles the actor cell. No borders. Theme-aware tokens.
 */
const ROWS = [
  ["Copy the source, hash it, log it", "code", "mechanical, exact, free"],
  ["Read messy prose to find its shape", "model", "nothing to parse, it takes reading"],
  ["Pick the type, write the summary, pull decisions", "model", "needs real understanding, the conscious work"],
  ["Assign tags, set the kind, wire the links", "model", "judgment about meaning, paid once"],
  ["File the note in its folder", "code", "once the type is decided, writing is mechanical"],
  ["Rebuild the index from every summary", "code", "a plain read over the note headers"],
  ["Rank notes for a search", "code", "fast, free, clear, over thousands of notes"],
  ["Turn a question into search words, read the top hits", "model", "it is the interface, with the question in hand"],
];
---

<div class="hiw-table">
  <table>
    <thead>
      <tr><th>Step</th><th>Who</th><th>Why</th></tr>
    </thead>
    <tbody>
      {
        ROWS.map(([step, who, why]) => (
          <tr>
            <td>
              <span class="step-text">{step}</span>
              <span class={`who step-who ${who}`}>{who}</span>
            </td>
            <td><span class={`who cell-who ${who}`}>{who}</span></td>
            <td>{why}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .hiw-table {
    margin: 1.4rem 0;
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  thead th {
    text-align: left;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    padding: 0 0.75rem 0.5rem;
  }
  tbody td {
    /* reset Starlight's inherited td bottom border (1px hairline) so it never
       paints stray dividers, clearest on mobile where cells stack into one card */
    border: 0;
    padding: 0.55rem 0.75rem;
    /* center the WHO pill in the row band so 1- and 2-line rows share an even
       vertical rhythm down the column (mobile resets this, cells stack there) */
    vertical-align: middle;
    color: var(--sl-color-gray-1);
    background: color-mix(in oklab, var(--sl-color-gray-3) 7%, var(--sl-color-bg));
  }
  tbody tr:nth-child(even) td {
    background: color-mix(in oklab, var(--sl-color-gray-3) 14%, var(--sl-color-bg));
  }
  tbody td:first-child {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  .who {
    display: inline-block;
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  /* the step-cell pill is mobile-only, the dedicated Who-cell pill is desktop-only */
  .step-who {
    display: none;
  }
  .who.model {
    background: color-mix(in oklab, var(--sl-color-text-accent) 22%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
  }
  .who.code {
    background: color-mix(in oklab, var(--sl-color-gray-3) 48%, var(--sl-color-bg));
    /* darker text on the gray fill so the "code" pill reads as cleanly as "model" */
    color: var(--sl-color-gray-0);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--sl-color-gray-2) 35%, transparent);
  }

  @media (max-width: 640px) {
    .hiw-table {
      overflow-x: visible;
    }
    table,
    tbody,
    tr,
    td {
      display: block;
      width: 100%;
    }
    thead {
      display: none;
    }
    /* one continuous card per row: the row carries the surface, the stacked
       cells inside it go transparent so there is no internal seam between the
       step+pill block and the why block. Gap shows only between rows. */
    tbody tr {
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 0.55rem;
      padding: 0.85rem 0.95rem;
      background: color-mix(in oklab, var(--sl-color-gray-3) 7%, var(--sl-color-bg));
    }
    tbody tr:nth-child(even) {
      background: color-mix(in oklab, var(--sl-color-gray-3) 14%, var(--sl-color-bg));
    }
    tbody td,
    tbody tr:nth-child(even) td {
      padding: 0;
      background: transparent;
    }
    tbody td:first-child {
      display: flex;
      align-items: baseline;
      gap: 0.35rem 0.5rem;
      flex-wrap: wrap;
      font-size: 1rem;
    }
    /* drop the dedicated Who cell, the pill is lifted into the step heading */
    tbody td:nth-child(2) {
      display: none;
    }
    /* the step text always takes the full row so the pill drops to its own line
       below every heading, one- and two-line alike, for a uniform pill rhythm */
    .step-text {
      flex-basis: 100%;
    }
    .step-who {
      display: inline-block;
      /* snug under the step heading, matching the comparison-card eyebrow gap */
      margin-top: 0.3rem;
      /* tight line-box so the pill adds no descender space below itself, which
         was inflating the gap to the WHY line into a hollow ~3-4x the gap above */
      line-height: 1;
    }
    tbody td:last-child {
      /* symmetric ~0.3rem gap above and below the pill so the card reads evenly
         balanced top-to-bottom, no hollow space under the chip */
      padding-top: 0.3rem;
      font-size: 0.88rem;
    }
  }
</style>
