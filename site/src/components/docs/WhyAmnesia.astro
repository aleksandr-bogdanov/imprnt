---
/**
 * Page-specific (why-imprnt): the no-memory problem made visible. Three chat
 * cards carry the exact same briefing in muted bubbles, then the ONE line each
 * chat was actually opened for, in the accent, then the memory wipe. The
 * briefing is the annoying part, the question is what should have been the
 * first message. The third card is "chat 47" to say this loop never ends.
 * Filled surfaces, no border boxes, sans only. Scoped CSS, theme-aware via
 * Starlight tokens, no Tailwind. Reveal animation is additive: without JS or
 * with reduced motion the strip renders fully visible.
 */
const BRIEF = ["here is my setup", "these are my constraints", "this is what we decided last week"];
const CHATS = [
  { tag: "chat 1", ask: "which bike for a fifteen-minute commute?" },
  { tag: "chat 2", ask: "is this clause in my rental contract normal?" },
  { tag: "chat 47", ask: "which tax form covers freelance income?" },
];
---

<div class="am" data-am>
  <div class="cards">
    {
      CHATS.map((c, ci) => (
        <div class="chat" style={`--d:${ci * 160}ms`}>
          <span class="ctag">{c.tag}</span>
          <div class="msgs">
            {BRIEF.map((l) => <span class="msg brief">{l}</span>)}
            <span class="asklabel">what I came to ask</span>
            <span class="msg ask">{c.ask}</span>
          </div>
          <span class="wipe"><b aria-hidden="true">&#10005;</b> chat ends, memory wiped</span>
        </div>
      ))
    }
  </div>
  <p class="cap">Three lines of the same briefing before the one line I came to ask. Every chat.</p>
</div>

<style>
  .am {
    margin: 1.6rem 0;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.7rem;
  }
  .chat {
    display: flex;
    flex-direction: column;
    border-radius: 13px;
    padding: 0.85rem 0.95rem 0.8rem;
    background: color-mix(in oklab, var(--sl-color-gray-4) 45%, var(--sl-color-bg));
    /* Starlight's global sibling spacing (* + * gets margin-top) reaches into
       this grid. Kill it here so all three share the row height. */
    margin-top: 0;
  }
  .ctag {
    font-family: var(--sl-font);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .msgs {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin: 0.6rem 0 0.75rem;
  }
  .msg {
    font-size: 0.78rem;
    line-height: 1.35;
    padding: 0.28rem 0.6rem;
    border-radius: 10px 10px 10px 4px;
  }
  .msg.brief {
    color: var(--sl-color-gray-2);
    background: color-mix(in oklab, var(--sl-color-gray-3) 18%, var(--sl-color-bg));
  }
  .asklabel {
    margin-top: 0.3rem;
    font-family: var(--sl-font);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
  }
  .msg.ask {
    font-weight: 600;
    color: var(--sl-color-white);
    background: color-mix(in oklab, var(--sl-color-text-accent) 16%, var(--sl-color-bg));
  }
  .wipe {
    margin-top: auto;
    font-family: var(--sl-font);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
  }
  .wipe b {
    font-weight: 700;
    color: color-mix(in oklab, var(--sl-color-red, #e5484d) 75%, var(--sl-color-gray-3));
    margin-right: 0.25rem;
  }
  .cap {
    margin: 0.8rem 0 0;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
  }

  /* reveal: armed only by JS, so no-JS and reduced-motion render static */
  .am.armed .chat {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.55s ease var(--d),
      transform 0.55s ease var(--d);
  }
  .am.armed.in .chat {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll("[data-am]").forEach((el) => {
    if (reduced || !("IntersectionObserver" in window)) return;
    el.classList.add("armed");
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            el.classList.add("in");
            io.disconnect();
          }
        }
      },
      { threshold: 0.2 },
    );
    io.observe(el);
  });
</script>
