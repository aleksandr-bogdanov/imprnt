---
/**
 * Page-specific (statusline): the "make it yours" note as a filled aside rather
 * than a trailing prose paragraph, so it reads as its own anchor next to the
 * panel. Filled surface, no border, theme-aware tokens.
 */
---

<div class="sl-cust">
  <span class="sl-cust-tag">make it yours</span>
  <p>
    The line is whatever <code>plugins/statusline/statusline.js</code> prints, so you can edit
    the segments. To keep the default pristine, copy the plugin into
    <code>plugins/_personal/</code> and wire your copy instead.
  </p>
</div>

<style>
  .sl-cust {
    margin: 1.4rem 0;
    padding: 0.95rem 1.1rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 9%, var(--sl-color-bg));
  }
  .sl-cust-tag {
    display: inline-block;
    font-family: var(--sl-font);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--sl-color-text-accent);
    margin-bottom: 0.5rem;
  }
  .sl-cust p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--sl-color-gray-1);
  }
  .sl-cust code {
    font-family: var(--sl-font-mono);
    font-size: 0.85em;
  }
</style>
