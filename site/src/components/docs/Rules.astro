---
/**
 * The four rules that keep plugins composable and the core blind. A compact
 * 4-row grid: each row is a short plain-language summary with the relevant code
 * token as a chip on the right. Borderless filled rows, scoped CSS, theme-aware
 * via Starlight tokens (no Tailwind: docs pages do not load it). The rows
 * cascade in one by one when scrolled into view (IntersectionObserver, an
 * animation rather than a transition so the hover lift keeps its own fast
 * timing, skipped under reduced motion or without JS).
 */
const RULES = [
  {
    title: "A plugin reads your notes, not the core",
    body: "A plugin opens your note files like any script would, and never imports imprnt's own code. So the core can change without breaking the plugin.",
  },
  {
    title: "A plugin never edits your notes",
    body: "A plugin writes only inside its own folder. To change one of your notes, the plugin hands you the edit and you approve it.",
  },
  {
    title: "Search only sees your vault",
    body: "Recall looks at your real notes, never a plugin's folder. A plugin gets into search only by proposing a note you approve.",
  },
  {
    title: "Nothing runs on its own",
    body: "A plugin acts only when you run or schedule it. Any label a plugin adds to your notes is name-tagged, so the core ignores it.",
  },
];
---

<div class="rules">
  {
    RULES.map((r, i) => (
      <div class="rule">
        <span class="num">{i + 1}</span>
        <div class="rule-body">
          <span class="rule-title">{r.title}</span>
          <p class="rule-text">{r.body}</p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .rules {
    display: grid;
    gap: 0.44rem;
    margin: 1.4rem 0;
  }
  /* scroll-gated cascade: rows hold transparent until the script marks the
     container .seen, then rise top to bottom. backwards fill keeps a delayed
     row hidden until its own start */
  @keyframes ruleIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .rule {
    opacity: 0;
  }
  .rules.seen .rule {
    opacity: 1;
    animation: ruleIn 0.5s cubic-bezier(0.22, 0.65, 0.3, 1) backwards;
  }
  .rules.seen .rule:nth-child(2) {
    animation-delay: 0.08s;
  }
  .rules.seen .rule:nth-child(3) {
    animation-delay: 0.16s;
  }
  .rules.seen .rule:nth-child(4) {
    animation-delay: 0.24s;
  }
  @media (prefers-reduced-motion: reduce) {
    .rule,
    .rules.seen .rule {
      opacity: 1;
      animation: none;
    }
  }
  /* with scripts off the observer never fires, so never hide the content */
  @media (scripting: none) {
    .rule {
      opacity: 1;
    }
  }
  .rule {
    display: grid;
    grid-template-columns: 1.9rem 1fr;
    align-items: start;
    gap: 0.4rem 0.9rem;
    padding: 0.8rem 1.05rem;
    border-radius: 12px;
    background: color-mix(in oklab, var(--sl-color-text-accent) 7%, var(--sl-color-bg));
    transition:
      transform 0.16s ease,
      background 0.16s ease,
      box-shadow 0.16s ease;
  }
  .rule:hover {
    transform: translateY(-2px);
    background: color-mix(in oklab, var(--sl-color-text-accent) 11%, var(--sl-color-bg));
    box-shadow: 0 10px 24px -18px color-mix(in oklab, var(--sl-color-text-accent) 80%, transparent);
  }
  .num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    font-family: var(--sl-font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
    color: var(--sl-color-bg);
    background: var(--sl-color-text-accent);
    border-radius: 9999px;
    margin-top: -0.07rem;
  }
  .rule-body {
    min-width: 0;
  }
  .rule-title {
    font-family: var(--sl-font);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--sl-color-white);
  }
  .rule-text {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--sl-color-gray-2);
  }
</style>

<script>
  // scroll-gated entrance: reveal immediately under reduced motion or when
  // IntersectionObserver is missing, otherwise cascade the rows on first view
  const roots = document.querySelectorAll(".rules");
  if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
    for (const el of roots) el.classList.add("seen");
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) {
            e.target.classList.add("seen");
            io.unobserve(e.target);
          }
      },
      { threshold: 0.12 },
    );
    for (const el of roots) io.observe(el);
  }
</script>
