---
import Lockup from "./Lockup.astro";
import { nav, site } from "../lib/content";
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-40 transition-[background-color,border-color] duration-300 [&.is-scrolled]:border-line [&.is-scrolled]:bg-bg border-b border-transparent"
>
  <nav class="shell flex h-16 items-center justify-between gap-4" aria-label="Primary">
    <a href="#top" aria-label="imprnt" class="flex items-center text-ink">
      <Lockup size={28} />
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm text-ink-soft transition-colors hover:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden items-center gap-3 md:flex">
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle light and dark theme"
        class="grid h-9 w-9 place-items-center rounded-full border border-line text-ink-soft transition-colors hover:border-accent hover:text-ink"
      >
        <svg class="theme-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-moon h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
      <a
        href={site.repo}
        target="_blank"
        rel="noreferrer"
        class="text-sm text-ink-soft transition-colors hover:text-ink"
        aria-label="imprnt on GitHub"
      >
        GitHub
      </a>
      <a href="/getting-started/" class="btn btn-primary !px-4 !py-2 text-sm">Get started</a>
    </div>

    <button
      type="button"
      data-menu-toggle
      aria-label="Open menu"
      aria-expanded="false"
      class="grid h-10 w-10 place-items-center rounded-full border border-line text-ink md:hidden"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>

  <!-- mobile panel -->
  <div
    data-menu-panel
    class="grid grid-rows-[0fr] overflow-hidden border-line bg-bg transition-[grid-template-rows] duration-300 ease-out data-[open]:grid-rows-[1fr] data-[open]:border-t md:hidden"
  >
    <div class="min-h-0">
      <ul class="shell flex flex-col gap-1 py-4">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-menu-link
                class="block rounded-lg px-3 py-3 text-ink-soft transition-colors hover:bg-surface hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="mt-2 flex gap-3 px-3">
          <button
            type="button"
            data-theme-toggle
            aria-label="Toggle light and dark theme"
            class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-line text-ink-soft"
          >
            <svg class="theme-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="theme-moon h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
          <a href={site.repo} target="_blank" rel="noreferrer" class="btn btn-ghost flex-1">GitHub</a>
          <a href="/getting-started/" data-menu-link class="btn btn-primary flex-1">Get started</a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector("[data-menu-toggle]");
    const panel = document.querySelector("[data-menu-panel]");
    if (!toggle || !panel) return;
    const close = () => {
      panel.removeAttribute("data-open");
      toggle.setAttribute("aria-expanded", "false");
    };
    toggle.addEventListener("click", () => {
      const open = panel.hasAttribute("data-open");
      if (open) close();
      else {
        panel.setAttribute("data-open", "");
        toggle.setAttribute("aria-expanded", "true");
      }
    });
    panel.querySelectorAll("[data-menu-link]").forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (ev) => {
      if (ev.key !== "Escape" || !panel.hasAttribute("data-open")) return;
      close();
      toggle.focus();
    });
  })();

  // theme toggle: flip data-theme, persist under Starlight's key so the docs
  // toggle and this one stay in sync. The icon shown is driven by CSS off the
  // resolved data-theme, so it is correct on first paint with no flash. The
  // theme-color meta follows, so mobile browser chrome matches the page.
  (() => {
    const root = document.documentElement;
    const sync = () => {
      const dark = root.dataset.theme !== "light";
      document.querySelectorAll("[data-theme-toggle]").forEach((b) =>
        b.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme"),
      );
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", dark ? "#141310" : "#f6f4ec");
    };
    sync();
    document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
        try {
          localStorage.setItem("starlight-theme", root.dataset.theme);
        } catch {}
        sync();
      });
    });
  })();
</script>
