---
// The imprnt logo lockup: the stamp mark + "imprnt." wordmark as one pure-vector
// SVG, outlined from Golos Text (no font dependency). Ink = currentColor (follows
// the element's text color, so it flips with the theme), accent = the teal token
// (with a Starlight fallback so it also resolves in the docs header). Size by
// height; width follows the viewBox aspect. Wrap it in a link with aria-label.
import lockupRaw from "../assets/lockup.svg?raw";

interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = "" } = Astro.props;

const svg = lockupRaw
  .replace(/\swidth="[^"]*"/, "")
  .replace(/\sheight="[^"]*"/, "")
  .replace("<svg ", `<svg height="${size}" aria-hidden="true" role="img" class="${cls}" `);
---

<Fragment set:html={svg} />
