---
/**
 * Renders a raw markdown note the way an editor colours it, and marks every
 * [[wikilink]] so the runtime can open the note it points at.
 *
 * It does NOT nest. An earlier version expanded links at build time, which is
 * exponential: every distinct path through the note graph got its own full copy of
 * every note it reached, and the example vault's cross-links produced a 168 MB page.
 * Each note is emitted ONCE by NoteStore.astro now, and popovers are assembled on
 * hover by its script, so depth is unlimited and the cost is linear.
 *
 * Colours follow the convention Obsidian and most markdown editors use, mapped onto
 * imprnt's own tokens rather than invented:
 *   frontmatter fence + keys   chrome ink, the way a key is always quieter than a value
 *   frontmatter values         body ink
 *   headings                   full ink, semibold
 *   [[wikilinks]]              the accent, because a link IS the accent's job
 *   ~~struck text~~            faint, struck - what the contract does to a stale fact
 *   list markers               faint, so the content sits forward of its bullet
 */
import { existsSync } from "node:fs";
import { join } from "node:path";

interface Props {
  text?: string;
  vault?: string;
}
const { text = "", vault = "" } = Astro.props;

/** A link only becomes openable if the vault actually has the note. */
const has = (target: string): boolean => (vault ? existsSync(join(vault, `${target}.md`)) : false);

type Tok = { k: string; v: string; target?: string };

/** Split one line into coloured tokens. Deliberately small: this styles a note, it is not a parser. */
function lineTokens(line: string, inFrontmatter: boolean): Tok[] {
  if (line.trim() === "---") return [{ k: "fence", v: line }];

  const out: Tok[] = [];
  let rest = line;

  if (inFrontmatter) {
    const m = rest.match(/^([A-Za-z_][\w-]*:)(.*)$/);
    if (m) {
      out.push({ k: "key", v: m[1] });
      rest = m[2];
    }
  } else if (/^#{1,6}\s/.test(rest)) {
    return [{ k: "heading", v: rest }];
  } else if (/^\s*[-*]\s/.test(rest)) {
    const m = rest.match(/^(\s*[-*]\s)(.*)$/)!;
    out.push({ k: "bullet", v: m[1] });
    rest = m[2];
  } else if (/^>\s?/.test(rest)) {
    const m = rest.match(/^(>\s?)(.*)$/)!;
    out.push({ k: "quote", v: m[1] });
    rest = m[2];
  }

  const re = /(\[\[[^\]]+\]\])|(~~[^~]+~~)/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(rest))) {
    if (m.index > last) out.push({ k: inFrontmatter ? "val" : "text", v: rest.slice(last, m.index) });
    if (m[1]) {
      const target = m[1].slice(2, -2);
      out.push({ k: "link", v: m[1], target: has(target) ? target : undefined });
    } else {
      out.push({ k: "gone", v: m[2] });
    }
    last = m.index + m[0].length;
  }
  if (last < rest.length) out.push({ k: inFrontmatter ? "val" : "text", v: rest.slice(last) });
  return out;
}

const lines = text.replace(/\s+$/, "").split("\n");
let fmOpen = false;
const rows = lines.map((l, i) => {
  const isFence = l.trim() === "---" && (i === 0 || fmOpen);
  const inFm = fmOpen;
  if (isFence) fmOpen = !fmOpen;
  return { toks: lineTokens(l, inFm && !isFence), blank: l.trim() === "" };
});
---

<span class="nb">
  {
    rows.map((r) => (
      <span class="nb-line">
        {r.blank
          ? " "
          : r.toks.map((t) =>
              t.k === "link" && t.target ? (
                <span class="nb-link nb-open" data-note={t.target} tabindex="0">{t.v}</span>
              ) : (
                <span class={`nb-${t.k}`}>{t.v}</span>
              ),
            )}
      </span>
    ))
  }
</span>

<style is:global>
  .nb {
    display: block;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.62;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .nb-line {
    display: block;
  }
  .nb-fence,
  .nb-key {
    color: var(--color-ink-chrome);
  }
  .nb-val,
  .nb-text {
    color: var(--color-ink-soft);
  }
  .nb-heading {
    font-weight: 600;
    color: var(--color-ink);
  }
  .nb-quote,
  .nb-bullet {
    color: var(--color-ink-faint);
  }
  .nb-gone {
    color: var(--color-ink-faint);
    text-decoration: line-through;
    text-decoration-thickness: from-font;
  }
  .nb-link {
    color: var(--color-accent);
  }

  /* a link the vault can resolve is openable; the panel is built at runtime */
  .nb-open {
    cursor: help;
    outline: none;
    border-bottom: 1px dotted color-mix(in oklab, var(--color-accent) 45%, transparent);
  }
  .nb-open:hover {
    border-bottom-style: solid;
  }
  .nb-open:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 3px;
  }
</style>
