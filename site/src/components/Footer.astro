---
import Lockup from "./Lockup.astro";
import { footer, site } from "../lib/content";
---

<footer class="relative border-t border-line bg-bg-soft">
  {/* The two link columns are `auto`, not `1fr`: sized to their content and
      pushed to the right margin, so the footer block has a real right edge
      instead of trailing off into a quarter-width void. Same decision the proof
      section's stacked links already make one screen up. */}
  <div class="shell grid gap-x-14 gap-y-10 py-16 md:grid-cols-[1fr_auto_auto]">
    <div>
      <a href="#top" aria-label="imprnt" class="flex items-center text-ink">
        <Lockup size={28} />
      </a>
      <p class="mt-4 max-w-sm text-sm text-ink-soft">{footer.blurb}</p>
      {/* the standing principle, not a second blurb sentence: it sits under a
          hairline at the chrome step, so it reads as the line the house signs
          off with rather than as more copy. max-w-sm, not xs: at 20rem the
          measure landed two characters short and broke "do the work" in half. */}
      <p class="mt-6 max-w-sm border-t border-line pt-5 text-sm text-ink-chrome">{site.principle}</p>
    </div>

    {
      footer.columns.map((col) => (
        <div>
          {/* the column head is a LABEL, so it takes the chrome step - every
              other tracked-caps label on this page does. At ink-soft it was the
              exact weight and colour of the links under it, so the head read as
              a fifth, shouty link instead of as the name of the column. */}
          <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-chrome">{col.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer" : undefined}
                  class="text-sm text-ink-soft transition-colors hover:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="hairline">
    <div class="shell flex flex-col items-center justify-between gap-3 py-6 text-sm text-ink-soft sm:flex-row">
      <p>{footer.copyright}</p>
      <div class="flex items-center gap-5">
        <a
          href="https://bogdanov.wtf"
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-2 transition-colors hover:text-ink"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
            <path d="M1 16.6 H23 M16.2 1 V16.6" stroke="var(--color-accent)" stroke-width="2.8" />
          </svg>
          built by bogdanov.wtf
        </a>
        <a href={site.repo} target="_blank" rel="noreferrer" class="transition-colors hover:text-ink">
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>
