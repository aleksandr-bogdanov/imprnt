---
import Lockup from "./Lockup.astro";
import { footer, site } from "../lib/content";
---

<footer class="relative border-t border-line bg-bg-soft">
  {/* Compact. The old shape stacked four links per column and jammed both columns
      against the right margin, leaving a screen-wide void in the middle and a
      footer taller than some sections of the page. Now the links run as ONE row
      of two groups on an even four-column grid, so the two lists sit at the
      thirds instead of hugging the right edge with a screen-wide void in the
      middle, and the block is about two thirds its old height. */}
  <div class="shell grid gap-x-10 gap-y-10 py-12 md:grid-cols-4 md:items-start">
    <div class="md:col-span-2 md:max-w-sm">
      <a href="#top" aria-label="imprnt" class="flex items-center text-ink">
        <Lockup size={26} />
      </a>
      <p class="mt-3 text-sm text-ink-soft">{footer.blurb}</p>
      {/* the standing principle, not a second blurb sentence: at the chrome step
          it reads as the line the house signs off with rather than as more copy */}
      <p class="mt-4 text-sm text-ink-chrome">{site.principle}</p>
    </div>

    <div class="contents max-md:flex max-md:flex-wrap max-md:gap-x-14 max-md:gap-y-8">
      {
        footer.columns.map((col) => (
          <div>
            {/* the column head is a LABEL, so it takes the chrome step - every other
                tracked-caps label on this page does. At ink-soft it was the exact
                weight and colour of the links under it. */}
            <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-chrome">{col.title}</h2>
            <ul class="mt-3 space-y-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noreferrer" : undefined}
                    class="text-sm text-ink-soft transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="hairline">
    <div class="shell flex flex-col items-center justify-between gap-3 py-5 text-sm text-ink-soft sm:flex-row">
      <p>{footer.copyright}</p>
      <div class="flex items-center gap-5">
        <a
          href="https://bogdanov.wtf"
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-2 transition-colors hover:text-ink"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
            <path d="M1 16.6 H23 M16.2 1 V16.6" stroke="var(--color-accent)" stroke-width="2.8" />
          </svg>
          built by bogdanov.wtf
        </a>
        <a href={site.repo} target="_blank" rel="noreferrer" class="transition-colors hover:text-ink">
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>
