---
import Lockup from "./Lockup.astro";
import { footer, site } from "../lib/content";
---

<footer class="relative border-t border-line bg-bg-soft">
  <div class="shell grid gap-10 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href="#top" aria-label="imprnt" class="flex items-center text-ink">
        <Lockup size={28} />
      </a>
      <p class="mt-4 max-w-xs text-sm text-ink-soft">{footer.blurb}</p>
      <p class="mt-6 text-sm italic text-ink-faint">{site.principle}</p>
    </div>

    {
      footer.columns.map((col) => (
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-ink-faint">{col.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer" : undefined}
                  class="text-sm text-ink-soft transition-colors hover:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="hairline">
    <div class="shell flex flex-col items-center justify-between gap-3 py-6 text-sm text-ink-faint sm:flex-row">
      <p>{footer.copyright}</p>
      <div class="flex items-center gap-5">
        <a
          href="https://bogdanov.wtf"
          target="_blank"
          rel="noreferrer"
          class="transition-colors hover:text-ink"
        >
          built by bogdanov.wtf
        </a>
        <a href={site.repo} target="_blank" rel="noreferrer" class="transition-colors hover:text-ink">
          GitHub
        </a>
      </div>
    </div>
  </div>
</footer>
