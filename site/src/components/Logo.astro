---
// The imprnt mark: a pressed fingerprint (an "imprint") on a dark stamp.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  class={cls}
  aria-hidden="true"
  role="img"
>
  <defs>
    <linearGradient id="imprntMark" x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
      <stop stop-color="#80e7a8"></stop>
      <stop offset="1" stop-color="#36c7bf"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="8.5" fill="#0d0f12"></rect>
  <rect x="1.25" y="1.25" width="29.5" height="29.5" rx="7.5" fill="none" stroke="url(#imprntMark)" stroke-opacity="0.4" stroke-width="1.2"></rect>
  <g stroke="url(#imprntMark)" stroke-width="2" stroke-linecap="round" fill="none">
    <path d="M9.5 16a6.5 6.5 0 0 1 13 0"></path>
    <path d="M12 16a4 4 0 0 1 8 0" stroke-opacity="0.8"></path>
    <path d="M9.5 16a6.5 6.5 0 0 0 4 6" stroke-opacity="0.55"></path>
  </g>
  <circle cx="16" cy="16" r="1.4" fill="url(#imprntMark)"></circle>
</svg>
