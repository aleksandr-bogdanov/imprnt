---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/content";
import { hero, problem, flow, lockin, different, closing } from "../lib/landing";

import HeroGraph from "../islands/HeroGraph.tsx";
import Terminal from "../islands/Terminal.tsx";
import CopyButton from "../islands/CopyButton.tsx";
import MagneticButton from "../islands/MagneticButton.tsx";
import LandingAmnesia from "../components/landing/LandingAmnesia.astro";
import LandingNote from "../components/landing/LandingNote.astro";
import LandingVault from "../components/landing/LandingVault.astro";

const icons: Record<string, string> = {
  shield: `<path d="M12 3 5 6v5c0 4.5 3 7.6 7 9 4-1.4 7-4.5 7-9V6z"/><path d="m9 12 2 2 4-4"/>`,
  blocks: `<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><path d="M16.5 14v6M13.5 17h6"/>`,
  bolt: `<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>`,
};
---

<Layout>
  {/* ─────────────────────────────  HERO  ───────────────────────────── */}
  <section class="relative overflow-hidden pb-24 pt-24 sm:pt-28">
    <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-px bg-line-soft"></div>

    <div class="shell grid items-center gap-x-12 gap-y-16 lg:grid-cols-[1fr_1.05fr]">
      <div>
        <p class="eyebrow" data-reveal>{hero.eyebrow}</p>
        <h1 class="mt-6 text-hero font-semibold" data-reveal data-reveal-delay="60">
          {hero.headlineLead}{" "}<span class="text-accent">{hero.headlineAccent}</span>.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink-soft sm:text-xl" data-reveal data-reveal-delay="120">
          {hero.subhead}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="180">
          <div class="flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3 font-mono text-sm">
            <span class="select-none text-accent">$</span>
            <span class="text-ink">{site.install}</span>
            <CopyButton client:visible value={site.install} label="install command" />
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="240">
          <MagneticButton client:visible href={hero.ctaPrimary.href} label={hero.ctaPrimary.label} variant="primary" arrow />
          <MagneticButton client:visible href={hero.ctaSecondary.href} label={hero.ctaSecondary.label} variant="ghost" external />
        </div>

        <p class="mt-10 max-w-md text-sm italic text-ink-soft" data-reveal data-reveal-delay="300">
          {site.principle}
        </p>
      </div>

      <div class="lg:pb-10" data-reveal data-reveal-delay="160">
        <HeroGraph client:load hintMobile={hero.graphHintMobile} />
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  PROBLEM  ───────────────────────────── */}
  <section class="relative border-t border-line py-20 sm:py-28">
    <div class="shell">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal>{problem.eyebrow}</p>
        <h2 class="mt-6 text-display font-semibold" data-reveal data-reveal-delay="60">{problem.heading}</h2>
        <p class="mt-7 text-lg text-ink-soft sm:text-xl" data-reveal data-reveal-delay="120">{problem.intro}</p>
      </div>

      <div class="mt-12" data-reveal data-reveal-delay="180">
        <LandingAmnesia />
      </div>

      <p class="mt-12 max-w-2xl text-lg text-ink-soft sm:text-xl" data-reveal>{problem.flip}</p>
    </div>
  </section>

  {/* ─────────────────────────────  FLOW  ───────────────────────────── */}
  <section id="how" class="relative border-t border-line bg-bg-soft py-20 sm:py-28">
    <div class="shell">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal>{flow.eyebrow}</p>
        <h2 class="mt-6 text-display font-semibold" data-reveal data-reveal-delay="60">{flow.heading}</h2>
        <p class="mt-6 text-lg text-ink-soft" data-reveal data-reveal-delay="120">{flow.lead}</p>
      </div>

      <ol class="mt-12 grid gap-3 sm:grid-cols-3">
        {
          flow.steps.map((s, i) => (
            <li class="flex items-start gap-3.5 rounded-2xl border border-line bg-surface p-5" data-reveal data-reveal-delay={i * 90}>
              <span class="font-mono text-sm font-semibold text-accent">{s.n}</span>
              <div>
                <p class="font-display font-semibold text-ink">{s.title}</p>
                <p class="mt-1 text-sm text-ink-soft">{s.sub}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 grid items-start gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:gap-12">
        <div data-reveal data-reveal-delay="120">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-soft">{flow.terminalLabel}</p>
          <Terminal lines={flow.terminal} />
          <p class="mt-4 text-sm text-ink-soft">{flow.terminalCaption}</p>
        </div>
        <div data-reveal data-reveal-delay="200">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-soft">{flow.noteLabel}</p>
          <LandingNote />
          <p class="mt-4 text-sm text-ink-soft">{flow.noteCaption}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  NO LOCK-IN  ───────────────────────────── */}
  <section class="relative overflow-hidden border-t border-line py-20 sm:py-28">
    <div class="shell">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow" data-reveal>{lockin.eyebrow}</p>
        <h2 class="mt-6 text-display font-semibold" data-reveal data-reveal-delay="60">{lockin.heading}</h2>
        <p class="mt-6 text-lg text-ink-soft" data-reveal data-reveal-delay="120">{lockin.lead}</p>
      </div>

      <div class="mt-12" data-reveal data-reveal-delay="140">
        <LandingVault />
      </div>

      <div class="mx-auto mt-10 max-w-2xl text-center">
        <p class="text-lg text-ink-soft" data-reveal>{lockin.kicker}</p>
        <div class="mt-6 flex justify-center" data-reveal data-reveal-delay="80">
          <MagneticButton client:visible href={lockin.cta.href} label={lockin.cta.label} variant="ghost" arrow />
        </div>
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  DIFFERENT  ───────────────────────────── */}
  <section id="different" class="relative border-t border-line bg-bg-soft py-20 sm:py-28">
    <div class="shell">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal>{different.eyebrow}</p>
        <h2 class="mt-6 text-display font-semibold" data-reveal data-reveal-delay="60">{different.heading}</h2>
        <p class="mt-6 text-lg text-ink-soft" data-reveal data-reveal-delay="120">{different.lead}</p>
      </div>

      <div class="mt-14 grid gap-4 sm:grid-cols-3">
        {
          different.features.map((f, i) => (
            <a
              href={f.href}
              class="surface group flex flex-col p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/45"
              data-reveal
              data-reveal-delay={(i % 3) * 70}
            >
              <span class="grid h-11 w-11 place-items-center rounded-xl border border-line bg-bg-soft text-accent transition-colors group-hover:border-accent/50">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                  <Fragment set:html={icons[f.icon]} />
                </svg>
              </span>
              <h3 class="mt-5 font-display text-lg font-bold">{f.title}</h3>
              <p class="mt-2.5 flex-1 text-[0.95rem] text-ink-soft">{f.body}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-accent opacity-0 transition-opacity group-hover:opacity-100">
                learn more
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  CLOSING  ───────────────────────────── */}
  <section class="relative overflow-hidden border-t border-line py-24 sm:py-32">
    <div class="shell-narrow relative text-center">
      <h2 class="text-display font-semibold" data-reveal>{closing.heading}</h2>
      <p class="mx-auto mt-4 max-w-md text-lg text-ink-soft" data-reveal data-reveal-delay="80">{closing.sub}</p>

      <div class="mt-9 flex justify-center" data-reveal data-reveal-delay="140">
        <div class="flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3 text-left font-mono text-sm">
          <span class="select-none text-accent">$</span>
          <span class="text-ink">{closing.install}</span>
          <CopyButton client:visible value={closing.install} label="install command" />
        </div>
      </div>

      <div class="mt-7 flex flex-wrap justify-center gap-3" data-reveal data-reveal-delay="200">
        <MagneticButton client:visible href={closing.ctaPrimary.href} label={closing.ctaPrimary.label} variant="primary" arrow />
        <MagneticButton client:visible href={closing.ctaSecondary.href} label={closing.ctaSecondary.label} variant="ghost" external />
      </div>
    </div>
  </section>
</Layout>
