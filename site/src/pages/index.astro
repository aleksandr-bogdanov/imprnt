---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/content";
import { hero, how, proof, file, closing } from "../lib/landing";

import Terminal from "../islands/Terminal.tsx";
import CopyButton from "../islands/CopyButton.tsx";
import MagneticButton from "../islands/MagneticButton.tsx";
import LandingNote from "../components/landing/LandingNote.astro";
import HowLanes from "../components/landing/HowLanes.astro";
import RecallBlock from "../components/landing/RecallBlock.astro";

// The motto is two sentences. Split it so a narrow screen breaks it at the full
// stop instead of mid-claim (text-balance was stranding "Every" at line end).
// If the copy ever becomes one sentence the whole string stays in the head.
const mottoBreak = hero.motto.indexOf(". ");
const mottoHead = mottoBreak < 0 ? hero.motto : hero.motto.slice(0, mottoBreak + 1);
const mottoTail = mottoBreak < 0 ? "" : hero.motto.slice(mottoBreak + 2);
---

<Layout>
  {/* ─────────────────────────────  HERO  ───────────────────────────── */}
  {/* Same rule as every other section: the eyebrow owns the top of the section
      at FULL width, and everything sits under it - the transcript's own label
      included. That label used to head the right column level with the eyebrow,
      which read as two competing kickers. It now sits at h1 level, so the two
      columns start on the same line under one section label. */}
  <section class="relative overflow-hidden pb-24 pt-24 sm:pt-28">
    <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-px bg-line-soft"></div>

    <div class="shell">
      <p class="eyebrow" data-reveal>{hero.eyebrow}</p>
    </div>

    <div class="shell mt-6 grid gap-x-12 gap-y-16 lg:grid-cols-[1.12fr_0.88fr] lg:items-start">
      <div>
        <h1 class="text-hero font-semibold" data-reveal data-reveal-delay="60">
          {hero.headlineLead}<br />
          <span class="text-accent sm:whitespace-nowrap">{hero.headlineAccent}</span>.
        </h1>
        {/* the motto is the second half of the hero UNIT, not a separate block:
            it hangs off the headline's last line on a tighter leading than the
            body that follows. The second sentence is held whole so a narrow
            screen breaks the motto at its full stop; text-balance was breaking
            it after "Every", which stranded the word and split the claim. */}
        <p class="mt-4 text-balance font-display text-xl font-semibold leading-snug text-ink sm:text-2xl" data-reveal data-reveal-delay="100">
          {mottoHead} <span class="whitespace-nowrap">{mottoTail}</span>
        </p>
        {hero.subheadParas.map((p, i) => (
          <p
            class={`${i === 0 ? "mt-7" : "mt-4"} max-w-xl text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg [&_strong]:font-semibold [&_strong]:text-ink`}
            data-reveal
            data-reveal-delay={140 + i * 40}
            set:html={p}
          />
        ))}

        <div class="mt-8" data-reveal data-reveal-delay="180">
          {/* the prompt marks where the command STARTS, so it top-aligns with
              the command's first line once the command wraps. The pair is its
              own flex row so the copy button stays optically centred. */}
          <div class="flex w-fit items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3 font-mono text-sm">
            <span class="flex min-w-0 items-start gap-3">
              <span class="shrink-0 select-none text-accent">$</span>
              <span class="text-ink">{site.install}</span>
            </span>
            <CopyButton client:visible value={site.install} label="install command" />
          </div>
          <p class="mt-3 max-w-md text-sm text-ink-soft">{hero.installCaption}</p>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="240">
          <MagneticButton client:visible href={hero.ctaPrimary.href} label={hero.ctaPrimary.label} variant="primary" arrow />
          <MagneticButton client:visible href={hero.ctaSecondary.href} label={hero.ctaSecondary.label} variant="ghost" external />
        </div>
      </div>

      {/* pt lands the transcript label's cap line on the h1's cap line (measured) */}
      <div class="lg:pt-[5px]" data-reveal data-reveal-delay="160">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-chrome">{hero.terminalLabel}</p>
        <Terminal lines={hero.terminal} />
        <p class="mt-4 text-sm text-ink-soft">{hero.terminalCaption}</p>
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  HOW IT WORKS  ───────────────────────────── */}
  <section id="how" class="relative border-t border-line bg-bg-soft py-20 sm:py-28">
    {/* Three bands, not one lopsided two-column grid. The old shape ran ALL the
        prose down the left and everything else down the right, so the left
        column ended half a screen before the right did - the fault Alex called
        out. Now: a full-width header, then origin-prose beside the lanes
        diagram, then a full-width spec strip, then the mechanism and the cost
        as two even columns. Each band's halves end together.

        Mobile stacks in source order, which already reads right: two
        paragraphs, then the diagram breaking the run, then the verdict line
        under it - the same reading the desktop columns give. No order
        overrides left. */}
    <div class="shell">
      <div class="max-w-5xl">
        <p class="eyebrow" data-reveal>{how.eyebrow}</p>
        {/* the heading breaks at its own full stop, so "The model writes the
            note." holds one line; text-balance would re-break it mid-clause */}
        <h2 class="mt-3 text-display font-semibold leading-[1.08] sm:[text-wrap:nowrap]" data-reveal data-reveal-delay="60">
          {how.headingLead}<br />{how.headingRest}
        </h2>
      </div>
    </div>

    {/* band A: the origin two paragraphs, with the lanes diagram holding the
        other half AND the verdict line sitting under it. The verdict is the
        sentence that names the split the diagram draws, so binding it to the
        figure is what makes the two halves end on the same line (317 vs 315px
        measured) instead of the card floating over 170px of dead paper - the
        tilt Alex called out. */}
    <div class="shell mt-12 grid items-start gap-x-12 gap-y-10 sm:mt-14 lg:grid-cols-2">
      <div>
        {how.paras.slice(0, 2).map((p, i) => (
          <p
            class={`max-w-2xl text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg [&_strong]:font-semibold [&_strong]:text-ink ${i === 0 ? "" : "mt-6"}`}
            data-reveal
            data-reveal-delay={120 + i * 40}
            set:html={p}
          />
        ))}
      </div>
      <div class="max-w-2xl" data-reveal data-reveal-delay="80">
        <HowLanes />
        <p
          class="mt-6 text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg [&_strong]:font-semibold [&_strong]:text-ink"
          set:html={how.paras[2]}
        />
      </div>
    </div>

    {/* band B: the spec strip, full width - the hairline that breaks the prose.
        A real datasheet row, not three words pushed to the edges: equal thirds,
        every label flush left in its own cell, and a full-height hairline
        between cells so the space after a short label reads as a cell, not as a
        void. Pushed to the edges (first on the text margin, last on the right)
        the three sat ~290px apart with nothing explaining the gap. */}
    <div class="shell mt-12 sm:mt-14">
      {/* three across only from md up: at 640-767 a third of the measure is
          narrower than "no index to rebuild", so the last cell wrapped to two
          lines while its neighbours held one. Below that it stacks, which is
          the same list the phone gets. */}
      <div class="grid grid-cols-1 gap-y-3 border-y border-line py-5 md:grid-cols-3 md:gap-y-0 md:py-0" data-reveal>
        {how.spec.map((s, i) => (
          <span
            class={`text-sm font-semibold uppercase tracking-wider text-ink-soft md:py-5 ${
              i === 0 ? "" : "md:border-l md:border-line md:pl-8"
            }`}
          >
            {s}
          </span>
        ))}
      </div>
    </div>

    {/* band C: mechanism left, cost right - two paragraphs each, even columns */}
    <div class="shell mt-12 grid items-start gap-x-12 gap-y-6 sm:mt-14 lg:grid-cols-2">
      <div>
        {how.paras2.slice(0, 2).map((p, i) => (
          <p
            class={`max-w-2xl text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg [&_strong]:font-semibold [&_strong]:text-ink ${i === 0 ? "" : "mt-6"}`}
            data-reveal
            data-reveal-delay={i * 40}
            set:html={p}
          />
        ))}
      </div>
      <div class="max-lg:mt-8 max-lg:border-t max-lg:border-line max-lg:pt-8">
        {how.paras2.slice(2).map((p, i) => (
          <p
            class={`max-w-2xl text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg [&_strong]:font-semibold [&_strong]:text-ink ${i === 0 ? "" : "mt-6"}`}
            data-reveal
            data-reveal-delay={80 + i * 40}
            set:html={p}
          />
        ))}
        <div class="mt-6 max-w-2xl">
          <a href={how.link.href} class="group inline-flex items-center gap-1.5 text-sm font-semibold text-accent underline-offset-4 hover:underline" data-reveal>
            {how.link.label}
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  PROOF  ───────────────────────────── */}
  {/* One rule across every section, Alex's call: the eyebrow and heading own the
      top of the section at full width, and EVERYTHING sits under them - including
      whatever rides in a right-hand column. The old side-by-side head put the
      claim level with the heading's second line and left the heading stranded. */}
  <section id="proof" class="relative border-t border-line py-20 sm:py-28">
    <div class="shell">
      <div class="max-w-5xl">
        <p class="eyebrow" data-reveal>{proof.eyebrow}</p>
        <h2 class="mt-3 text-display font-semibold leading-[1.08]" data-reveal data-reveal-delay="60">{proof.heading}</h2>
      </div>

      <div class="mt-12 max-w-3xl sm:mt-14">
        <p
          class="text-balance font-display text-2xl font-semibold text-ink [&_strong]:text-accent sm:text-3xl"
          data-reveal
          data-reveal-delay="100"
          set:html={proof.leadTop}
        />
        <p
          class="mt-4 text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg [&_strong]:font-semibold [&_strong]:text-ink"
          data-reveal
          data-reveal-delay="140"
          set:html={proof.leadBody}
        />
      </div>

      {/* the numerals carry display leading (1.02), not the body's 1.65: at
          body leading a 2.75rem figure sits in a 72px line box, so each number
          floated a half-line clear of the rule above it and of its own label.
          Tight leading binds value to label, and the pair sits centred between
          the two rules. */}
      <div class="mt-12 grid gap-y-8 border-y border-line py-9 sm:mt-14 sm:grid-cols-3 sm:gap-x-10" data-reveal data-reveal-delay="140">
        {
          proof.stats.map((s) => (
            <div>
              <p class="font-display text-[2.4rem] font-semibold leading-[1.02] tracking-[-0.025em] text-ink sm:text-[2.75rem]">{s.value}</p>
              <p class="mt-3 max-w-[20rem] text-sm text-ink-soft">{s.label}</p>
            </div>
          ))
        }
      </div>

      {/* the capture runs full width now that Letta's paragraph is gone from
          beside it: it is the section's evidence, so it gets the whole measure
          instead of being squeezed into 1.15fr against a thin column */}
      <div class="mt-12 sm:mt-14" data-reveal data-reveal-delay="160">
        <RecallBlock />
        <p class="mt-4 max-w-2xl text-sm text-ink-soft">{proof.recallCaption}</p>
      </div>

      {/* the two links stack and end on the right margin, so their arrows make a
          column and the block has a real edge. Side by side they wrapped inside
          a full-width flex row and both ends floated: the first link's label
          started mid-measure and the second stopped ~80px short of the rule
          above it, which read as an accident. The first link's cap line sits on
          the dogfood paragraph's first baseline. */}
      <div class="mt-12 flex flex-col gap-6 border-t border-line pt-8 sm:mt-14 sm:flex-row sm:items-baseline sm:justify-between sm:gap-x-12" data-reveal data-reveal-delay="200">
        <p class="max-w-md text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg">{proof.dogfood}</p>
        <div class="flex flex-col items-start gap-3 sm:items-end">
          <a href={proof.evalLink.href} class="group inline-flex items-center gap-1.5 text-sm font-semibold text-accent underline-offset-4 hover:underline">
            {proof.evalLink.label}
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href={proof.compareLink.href} class="group inline-flex items-baseline gap-1.5 text-sm font-semibold text-accent underline-offset-4 hover:underline">
            {proof.compareLink.label}
            {/* chrome, not faint, for the same reason as the closing quip: it
                is prose, and ink-faint is reserved for muted chrome inside the
                code captures (dim folders, struck values, frontmatter keys) */}
            <span class="font-normal text-ink-chrome">({proof.compareLink.note})</span>
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 self-center transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  THE FILE  ───────────────────────────── */}
  {/* Same rule as the proof section: eyebrow and heading own the top at full
      width, the two columns start underneath. Previously the heading rode in
      the left column, so the note card in the right column sat ABOVE it. */}
  <section id="the-file" class="relative border-t border-line bg-bg-soft py-20 sm:py-28">
    <div class="shell">
      <div class="max-w-5xl">
        <p class="eyebrow" data-reveal>{file.eyebrow}</p>
        <h2 class="mt-3 text-display font-semibold leading-[1.08]" data-reveal data-reveal-delay="60">{file.heading}</h2>
      </div>
    </div>

    {/* Three paragraphs against the note card, and the two halves land within
        20px of each other. The fourth paragraph used to ride under the card,
        which pushed the right column ~190px past the left and left a hole in
        the bottom-left corner - the same tilt as the how section, mirrored. It
        is the section's coda anyway ("the trade for all of this"), so it now
        closes the section full width under a rule.

        Mobile keeps the note card second, right after the paragraph that makes
        the "every note is a markdown file" claim, so no run of prose passes two
        paragraphs before a visual. */}
    <div class="shell mt-12 grid items-start gap-x-12 gap-y-0 sm:mt-14 lg:grid-cols-2 lg:gap-y-10">
      <div class="contents lg:block lg:max-w-xl">
        {file.paras.slice(0, 3).map((p, i) => (
          <p
            class={`max-w-xl text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg [&_strong]:font-semibold [&_strong]:text-ink ${["order-1", "order-2 mt-6", "order-4 mt-6"][i]}`}
            data-reveal
            data-reveal-delay={120 + i * 40}
            set:html={p}
          />
        ))}
      </div>

      {/* same nudge as the hero: 5px lands the card label's cap line on the cap
          line of the paragraph starting the other column */}
      <div class="order-3 mt-10 mb-4 lg:order-none lg:mb-0 lg:mt-0 lg:max-w-xl lg:pt-[5px]" data-reveal data-reveal-delay="180">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-ink-chrome">{file.noteLabel}</p>
        <LandingNote />
        <p class="mt-4 text-sm text-ink-soft">{file.noteCaption}</p>
      </div>
    </div>

    {/* the coda: full width under a rule, held to a reading measure */}
    <div class="shell mt-12 sm:mt-14">
      <div class="border-t border-line pt-8">
        <p
          class="max-w-3xl text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg [&_strong]:font-semibold [&_strong]:text-ink"
          data-reveal
          data-reveal-delay="240"
          set:html={file.paras[3]}
        />
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  CLOSING  ───────────────────────────── */}
  <section class="relative overflow-hidden border-t border-line py-24 sm:py-32">
    <div class="shell-narrow relative text-center">
      <h2 class="text-display font-semibold" data-reveal>
        {closing.headingLead} <span class="whitespace-nowrap">{closing.headingTail}</span>
      </h2>
      {/* max-w-md cut this one word short and left "to end." alone on line two */}
      <p class="mx-auto mt-4 max-w-lg text-lg text-ink-soft" data-reveal data-reveal-delay="80">{closing.sub}</p>

      {/* the command and the two buttons are one action cluster, so they sit
          closer to each other (24) than the cluster sits to the sub-line (40) */}
      <div class="mt-10 flex justify-center" data-reveal data-reveal-delay="140">
        <div class="flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3 text-left font-mono text-sm">
          <span class="flex min-w-0 items-start gap-3">
            <span class="shrink-0 select-none text-accent">$</span>
            <span class="text-ink">{closing.install}</span>
          </span>
          <CopyButton client:visible value={closing.install} label="install command" />
        </div>
      </div>

      <div class="mt-6 flex flex-wrap justify-center gap-3" data-reveal data-reveal-delay="200">
        <MagneticButton client:visible href={closing.ctaPrimary.href} label={closing.ctaPrimary.label} variant="primary" arrow />
        <MagneticButton client:visible href={closing.ctaSecondary.href} label={closing.ctaSecondary.label} variant="ghost" external />
      </div>

      {/* chrome, not faint: this is prose the reader is meant to read, and
          ink-faint measures 3.1:1 on paper and 3.9:1 on the dark ground. The
          chrome step clears 4.5:1 in both themes and still sits a step under
          the body, which is all the recession the line needs. */}
      <p class="mx-auto mt-14 max-w-md text-balance text-sm text-ink-chrome" data-reveal data-reveal-delay="260">
        {closing.quip}
      </p>
    </div>
  </section>
</Layout>
