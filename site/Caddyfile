# Railway injects $PORT. A bare :port address keeps Caddy on plain HTTP
# (Railway terminates TLS at its edge).
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# long-cache the content-hashed Astro assets
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# trailing-slash routes only. A path that matches nothing falls through to
	# the 404 below, never to the landing.
	try_files {path} {path}/
	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
