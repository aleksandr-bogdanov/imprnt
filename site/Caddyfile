# Railway injects $PORT. A bare :port address keeps Caddy on plain HTTP
# (Railway terminates TLS at its edge).
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# long-cache the content-hashed Astro assets
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}/ /index.html
	file_server
}
