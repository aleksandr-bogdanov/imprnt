# Your actual private knowledge base — never committed.
# `imprint init` scaffolds these from templates/.
/vault/
/raw/
.manifest.json

# Personal, per-machine plugin toggles — your @import wiring, never shipped.
CLAUDE.local.md

# Personal plugins — your private DA instance + voice overlay, never in the public gallery.
plugins/_personal/

# Build scratch — transient implementation plans, local working notes only. Never shipped.
Plans/

# Build output — regenerated by `bun run build`, shipped via npm `files`, never committed.
dist/

# Shipped-doc copies — each package's `shipdocs` copies these from the repo root at publish time.
packages/imprnt/CLAUDE.md
packages/imprnt/README.md
packages/imprnt/LICENSE

# Built plugin artifacts — compiled from each plugin's src/ by its build script, shipped, not committed.
# One glob, not a per-name list, so a new plugin's built entry is ignored without editing this file.
# Every top-level .js in a plugin package is built output. Hand-written top-level scripts are
# .mjs/.sh and don't match; a deliberately committed .js would need a `!` exception here.
packages/plugin-*/*.js

# Runtime
node_modules/
*.log
.DS_Store
.idea/

# examples/ IS committed — it's the synthetic demo of the loop.

# Turborepo local cache
.turbo/
