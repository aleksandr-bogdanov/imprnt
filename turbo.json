{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "inputs": ["src/**", "scripts/**", "templates/**", "package.json", "tsconfig.json"],
      "outputs": ["dist/**", "check.js", "timemachine.js", "whenful.js", "statusline.js", "kopeika.js"]
    },
    "typecheck": {
      "inputs": ["src/**", "scripts/**", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**", "scripts/**", "templates/**", "package.json", "tsconfig.json"],
      "outputs": []
    }
  }
}
