{
  "name": "imprint",
  "version": "0.1.0",
  "description": "Deterministic-first, plain-markdown knowledge vault. Code does the bulk transform; the LLM only touches the irreducibly-semantic 20%. Native grep retrieval, zero MCP on the vault.",
  "type": "module",
  "bin": {
    "imprint": "scripts/cli.ts"
  },
  "scripts": {
    "ingest": "bun scripts/ingest.ts",
    "recall": "bun scripts/recall.ts",
    "hot": "bun scripts/cli.ts hot",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun scripts/cli.ts check"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "author": "Aleksandr Bogdanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksandr-bogdanov/imprint.git"
  },
  "keywords": [
    "knowledge-base",
    "markdown",
    "second-brain",
    "deterministic",
    "cli",
    "agent-context"
  ],
  "files": [
    "scripts",
    "templates",
    "plugins",
    "!plugins/_personal",
    "CLAUDE.md",
    "README.md"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
