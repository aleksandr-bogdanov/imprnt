{
  "name": "imprint-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for imprint (core CLI) and the imprint-plugin-* gallery. Not published — each package under packages/ publishes itself.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build"
  },
  "license": "MIT",
  "author": "Aleksandr Bogdanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksandr-bogdanov/imprint.git"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.2"
  }
}
