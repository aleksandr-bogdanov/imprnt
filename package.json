{
  "name": "imprnt-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for imprnt (core CLI) and the imprnt-plugin-* gallery. Not published — each package under packages/ publishes itself.",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test build"
  },
  "license": "MIT",
  "author": "Aleksandr Bogdanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksandr-bogdanov/imprnt.git"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "turbo": "^2.9.16",
    "typescript": "^5.7.2"
  }
}
