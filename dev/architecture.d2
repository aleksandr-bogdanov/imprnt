# imprint - the loop, left to right. Starts at Claude, ends at Claude.
# Render: d2 dev/architecture.d2 dev/architecture.svg && d2 dev/architecture.d2 dev/architecture.png
direction: right

claude_in: "Claude - entrypoint" {
  style.fill: "#dbeafe"
  t: "you talk in plain language"
  t2: "drop a source: transcript, doc, a single fact"
}

skill: "Skill (shareable)" {
  t: "splits each job: deterministic bulk + the semantic 20%"
}

cli: "imprint CLI - the deterministic part" {
  style.fill: "#ecfdf5"
  t: "off-context · ~free · zero LLM"
  loop: "ingest -> recall (BM25) -> check"
}

vault: "Vault - your owned knowledge" {
  t: "plain markdown · grep + BM25 · no MCP, no vectors"
  raw: "raw/ - immutable by-source snapshots (never searched)"
  layout: "entities · domains · forms"
}

claude_out: "Claude - synthesis & answer" {
  style.fill: "#dbeafe"
  t: "the judgment 20% · answer · plan"
  r: "OAuth · never claude -p"
}

plugins: "Plugins (opt-in, rm -rf-able)" {
  style.stroke-dash: 3
  t: "character · anti-slop · whenful · guard"
  t2: "read vault · propose notes · never mutate"
}

whenful: "Whenful - tasks (sync at its own edge)" { style.stroke-dash: 3 }
obsidian: "Obsidian - human graph view" { style.stroke-dash: 3 }

claude_in -> skill: "invoke"
skill -> cli: "deterministic bulk"
cli -> vault: "write · grep · BM25 rank"
vault -> claude_out: "top-N hits (the two ends only)"
claude_out -> claude_in: "next turn" { style.stroke-dash: 2 }
plugins -> vault: "propose" { style.stroke-dash: 3 }
whenful -> plugins: "mirror" { style.stroke-dash: 3 }
vault -> obsidian { style.stroke-dash: 3 }
